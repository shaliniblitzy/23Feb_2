# =============================================================================
# E-Commerce Microservices — Environment Variable Template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All secrets must be placeholders here; real values go in `.env` or a secret
# manager (Vault, AWS Secrets Manager, Kubernetes Secrets) in production.
#
# This template is the SUPERSET of every cross-service integration variable
# referenced by the root `docker-compose.yml`, the per-service `config/*.yaml`
# files, and the Kubernetes manifests under `deploy/k8s/`. Reading this file
# top-to-bottom tells you exactly which credentials and endpoints the platform
# needs to operate end-to-end.
#
# Conventions:
#   * Keys are UPPER_SNAKE_CASE.
#   * `changeme` indicates a generic password placeholder — rotate before use.
#   * `<descriptor>` indicates a sensitive value with a specific format hint.
#   * Internal DNS names (e.g. `http://kafka:9092`) are Docker Compose service
#     names and are checked in as concrete defaults — they are not secrets.
#
# Forbidden in this file (enforced by AAP R-25):
#   * Real API keys (e.g. Stripe `sk_live_*`, Razorpay `rzp_live_*`).
#   * Real webhook secrets, OAuth client secrets, JWT signing keys.
#   * Real cloud credentials (AWS access keys, GCP service-account JSON, etc.).
#   * Any production-grade password or token.
# =============================================================================


# =============================================================================
# 1. Global
# =============================================================================
# Compose project name — namespaces container, network, and volume names so
# multiple developers can run the stack on the same host without collisions.
COMPOSE_PROJECT_NAME=ecommerce-microservices

# Application log level shared by every service container.
# Allowed values: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Logical environment name — propagated to every log line and metric tag so
# observability dashboards can filter by deployment target.
# Allowed values: local | dev | staging | prod
ENVIRONMENT=local


# =============================================================================
# 2. Kafka & Schema Registry
# =============================================================================
# Apache Kafka is the asynchronous event backbone of the platform (AAP R-14).
# Every domain service produces and/or consumes Kafka events; Schema Registry
# stores and validates the Avro/JSON Schema contract for every event type.

# Comma-separated list of Kafka bootstrap servers (host:port).
# In Compose, `kafka` resolves to the broker container; in production this
# should be the cluster's external listener with TLS.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Confluent Schema Registry endpoint used by every producer and consumer.
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Common prefix prepended to every Kafka client.id — aids broker-side
# observability and quota enforcement.
KAFKA_CLIENT_ID_PREFIX=ecommerce

# Common prefix prepended to consumer group.id — services append their own
# name to form the final group (e.g. `ecommerce-order-service`).
KAFKA_CONSUMER_GROUP_PREFIX=ecommerce

# Default offset reset behavior for new consumer groups.
# Allowed values: earliest | latest | none
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Kafka consumer retry / DLQ policy (per AAP R-17) ---
# Maximum number of redelivery attempts before a poison message is routed
# to the topic's `<topic>.dlq` partner.
KAFKA_RETRY_MAX_ATTEMPTS=5

# Initial backoff between retry attempts in milliseconds.
KAFKA_RETRY_INITIAL_BACKOFF_MS=500

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff).
KAFKA_RETRY_BACKOFF_MULTIPLIER=2.0

# Cap on the backoff so the consumer never sleeps for an unbounded duration.
KAFKA_RETRY_MAX_BACKOFF_MS=30000


# =============================================================================
# 3. HTTP Client Resilience (per AAP R-15, R-16)
# =============================================================================
# Default retry and circuit-breaker values applied to every outbound HTTP call.
# Individual call sites may override these via per-service `config/*.yaml`.

# Maximum total attempts (initial + retries) for an idempotent HTTP request.
HTTP_RETRY_MAX_ATTEMPTS=3

# Initial backoff before the first retry, in milliseconds.
HTTP_RETRY_INITIAL_BACKOFF_MS=200

# Multiplier applied to backoff between attempts (exponential backoff).
HTTP_RETRY_BACKOFF_MULTIPLIER=2.0

# Maximum random jitter added to each backoff (milliseconds) — prevents
# thundering-herd retries from synchronizing across replicas.
HTTP_RETRY_JITTER_MS=100

# Per-request connect + read timeout in milliseconds.
HTTP_TIMEOUT_MS=5000

# --- Circuit breaker defaults (per AAP R-16) ---
# Number of consecutive failures within the rolling window required to trip
# the breaker into the OPEN state.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Duration the breaker stays OPEN before transitioning to HALF_OPEN, in ms.
CIRCUIT_BREAKER_OPEN_DURATION_MS=30000

# Maximum concurrent probe calls allowed in the HALF_OPEN state.
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3


# =============================================================================
# 4. Auth Service — OAuth 2.0 + JWT (per AAP R-21, R-22, R-23)
# =============================================================================
# The Auth Service is the SOLE issuer of JWT tokens (R-21). All other services
# only validate JWTs using the published JWKS endpoint — they never mint tokens.

# Auth Service private database (PostgreSQL).
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=changeme
AUTH_DB_URL=postgresql://auth_user:changeme@auth-db:5432/auth_db

# Service base URL exposed to the API Gateway and to other services for
# token introspection.
AUTH_SERVICE_URL=http://auth-service:8080

# JWT issuer (`iss` claim) — must be a stable URL the platform controls.
JWT_ISSUER=https://auth.local.ecommerce.dev

# JWT audience (`aud` claim) — every service must enforce this on incoming tokens.
JWT_AUDIENCE=ecommerce-api

# Signing algorithm — RS256 is mandatory per R-22 (asymmetric, JWKS-distributed).
JWT_SIGNING_ALGORITHM=RS256

# Access-token lifetime in seconds (15 minutes default).
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh-token lifetime in seconds (30 days default).
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# JWKS endpoint published by the Auth Service. Every other service caches
# this with a bounded TTL to validate JWT signatures (R-22).
JWT_JWKS_URL=http://auth-service:8080/.well-known/jwks.json

# OAuth 2.0 Authorization Code (with PKCE) endpoint — used by clients to
# obtain an authorization code (RFC 6749 §4.1, R-23).
OAUTH_AUTHORIZATION_ENDPOINT=http://auth-service:8080/oauth/authorize

# OAuth 2.0 Token endpoint — exchanges authorization codes / refresh tokens
# / client credentials for access tokens.
OAUTH_TOKEN_ENDPOINT=http://auth-service:8080/oauth/token


# =============================================================================
# 5. User Service
# =============================================================================
# Owns user profiles, preferences, and addresses. Emits `user.updated` and
# `user.deleted` events; consumes `user.registered` from the Auth Service.

USER_DB_USER=user_user
USER_DB_PASSWORD=changeme
USER_DB_URL=postgresql://user_user:changeme@user-db:5432/user_db
USER_SERVICE_URL=http://user-service:8080


# =============================================================================
# 6. Product Service (MongoDB)
# =============================================================================
# Owns the product catalog and category tree. MongoDB is chosen for the
# flexible product schema (variants, attributes, media). Emits `product.created`
# and `product.updated` events.

PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=changeme
PRODUCT_DB_URL=mongodb://product_user:changeme@product-db:27017/product_db?authSource=admin
PRODUCT_SERVICE_URL=http://product-service:8080


# =============================================================================
# 7. Inventory Service
# =============================================================================
# Owns stock items, reservations, warehouses, and stock movements. Consumes
# `order.created`; emits `inventory.reserved`, `inventory.released`, and
# `inventory.low-stock`.

INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=changeme
INVENTORY_DB_URL=postgresql://inventory_user:changeme@inventory-db:5432/inventory_db
INVENTORY_SERVICE_URL=http://inventory-service:8080


# =============================================================================
# 8. Order Service (Saga Coordinator)
# =============================================================================
# Coordinates the checkout saga: create-order -> reserve-inventory ->
# take-payment -> confirm OR compensate. Emits `order.created`,
# `order.cancelled`, `order.fulfilled` (per AAP R-18).

ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=changeme
ORDER_DB_URL=postgresql://order_user:changeme@order-db:5432/order_db
ORDER_SERVICE_URL=http://order-service:8080

# Maximum time (ms) a single saga step may take before the orchestrator
# considers it timed out and triggers compensation.
SAGA_STEP_TIMEOUT_MS=10000

# Maximum time (ms) for the full compensation chain to complete after a
# saga failure. Tuned to be longer than a single step because compensation
# may itself involve multiple downstream calls.
SAGA_COMPENSATION_TIMEOUT_MS=30000


# =============================================================================
# 9. Payment Service — Dual Provider (per AAP R-10, R-12)
# =============================================================================
# Dual-provider integration: Stripe (global) and Razorpay (India) sit behind a
# unified `PaymentProvider` interface. Provider selection is data-driven by
# currency / region / merchant preference (R-10).
#
# IMPORTANT: Production MUST mount `payment_db` on an encrypted volume (R-8)
# and persist idempotency keys for every outbound provider call.

PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=changeme
PAYMENT_DB_URL=postgresql://payment_user:changeme@payment-db:5432/payment_db
PAYMENT_SERVICE_URL=http://payment-service:8080

# --- Stripe (global markets) ---
# Use the `sk_test_*` key for development; never commit a `sk_live_*` key.
# Values are quoted because the `<...>` placeholder syntax contains shell
# metacharacters; dotenv parsers (and `source`) strip the surrounding quotes.
STRIPE_API_KEY="<sk_test_xxx>"
STRIPE_PUBLISHABLE_KEY="<pk_test_xxx>"
# Webhook signing secret — used by the Payment Service to verify webhook
# signatures per AAP R-12 (idempotent on the provider's event ID).
STRIPE_WEBHOOK_SECRET="<whsec_xxx>"
STRIPE_API_BASE=https://api.stripe.com

# --- Razorpay (India) ---
RAZORPAY_KEY_ID="<rzp_test_xxx>"
RAZORPAY_KEY_SECRET="<changeme>"
RAZORPAY_WEBHOOK_SECRET="<changeme>"
RAZORPAY_API_BASE=https://api.razorpay.com

# --- Provider Routing (per AAP R-10: data-driven, not hard-coded) ---
# Default provider when no rule matches.
PAYMENT_DEFAULT_PROVIDER=stripe
# Override: route INR-denominated charges to Razorpay.
PAYMENT_ROUTE_BY_CURRENCY_INR=razorpay
# Override: route India-region merchants to Razorpay.
PAYMENT_ROUTE_BY_REGION_IN=razorpay


# =============================================================================
# 10. Notification Service — Dual Channel (per AAP R-11)
# =============================================================================
# Dual-channel dispatcher: Email and SMS sit behind a unified
# `NotificationChannel` interface. Channel selection is driven by event type
# and per-user preferences. Consumes `order.*`, `payment.*`, `user.registered`.

NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=changeme
NOTIFICATION_DB_URL=postgresql://notification_user:changeme@notification-db:5432/notification_db
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# --- Email provider (SendGrid OR AWS SES) ---
# Switch the adapter implementation at runtime (R-11): `sendgrid` or `ses`.
EMAIL_PROVIDER=sendgrid
# Quoted because `<...>` contains shell metacharacters; dotenv parsers strip quotes.
EMAIL_PROVIDER_API_KEY="<SG.xxx>"
EMAIL_FROM_ADDRESS=no-reply@local.ecommerce.dev
EMAIL_FROM_NAME="E-Commerce Platform"

# --- SMS provider (Twilio OR AWS SNS) ---
# Switch the adapter implementation at runtime (R-11): `twilio` or `sns`.
SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY="<AC_account_sid>"
SMS_PROVIDER_AUTH_TOKEN="<changeme>"
SMS_FROM_NUMBER="<+1xxxxxxxxxx>"

# --- Notification retry / DLQ policy (per AAP R-15, R-17) ---
# Maximum send attempts per notification before persisting to the DLQ.
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
# When true, exhausted notifications land on `notifications.<channel>.dlq`.
NOTIFICATION_DLQ_ENABLED=true


# =============================================================================
# 11. Recommendation Engine
# =============================================================================
# ML-based personalized product recommendations. Vector store holds product
# and user embeddings; Redis caches hot recommendations. Falls back to a
# popularity-based strategy on inference miss (per AAP R-20).

RECO_VEC_USER=reco_user
RECO_VEC_PASSWORD=changeme
RECO_VEC_URL=postgresql://reco_user:changeme@recommendation-vec:5432/recommendation_db
RECO_CACHE_URL=redis://recommendation-cache:6379/0
RECO_SERVICE_URL=http://recommendation-engine:8080

# Filesystem path inside the container where the trained ML model is mounted.
RECO_MODEL_PATH=/app/models/default

# Fallback strategy when the model returns no result or the inference path
# trips its circuit breaker. Allowed values: popularity | trending | none
RECO_FALLBACK_STRATEGY=popularity

# Cache TTL (seconds) for materialized recommendation lists in Redis.
RECO_CACHE_TTL_SECONDS=300


# =============================================================================
# 12. API Gateway
# =============================================================================
# The single edge entry point fronting all client traffic. Handles routing,
# JWT introspection, rate limiting, and TLS termination.

GATEWAY_URL=http://api-gateway:8000

# Per-client rate limit applied across all routes (token-bucket).
GATEWAY_RATE_LIMIT_PER_MINUTE=600

# Burst capacity allowed above the steady-state rate.
GATEWAY_RATE_LIMIT_BURST=60

# Upstream timeout the gateway applies to every backend call before it
# returns 504 Gateway Timeout to the client.
GATEWAY_UPSTREAM_TIMEOUT_MS=10000


# =============================================================================
# 13. ELK Observability Stack
# =============================================================================
# Centralized logging and monitoring (per AAP R-26, R-27, R-28, R-29).
# Filebeat / Metricbeat ship structured JSON logs and host/container metrics
# to Logstash, which normalizes and forwards to Elasticsearch. Kibana hosts
# per-domain dashboards.

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
KIBANA_URL=http://kibana:5601
LOGSTASH_HOST=logstash
LOGSTASH_BEATS_PORT=5044

# Composite host:port consumed by Filebeat / Metricbeat outputs.
BEATS_OUTPUT_HOST=logstash:5044


# =============================================================================
# 14. Correlation ID (per AAP R-13)
# =============================================================================
# HTTP header used by every service and the API Gateway to propagate a
# correlation ID for distributed tracing. The same value is also placed on
# Kafka message headers so async flows remain traceable end-to-end.
CORRELATION_ID_HEADER=X-Correlation-ID
