# =============================================================================
# Notification Service — Environment Variable Template
# =============================================================================
# Copy this file to `.env` for local development and populate real values.
# Never commit real secrets to source control (see AAP R-25).
# In production, values are injected from Kubernetes Secrets / HashiCorp Vault.
# =============================================================================
#
# Per AAP R-25 (CRITICAL SECURITY RULE):
#   "Secrets must never appear in source or configuration files. Use Kubernetes
#    Secrets, Vault, or cloud provider secret managers; `.env.example` files
#    contain only variable names, never values."
#
# Conventions followed in this file:
#   * Variable names use SCREAMING_SNAKE_CASE exclusively.
#   * Sensitive variables (database URLs, API keys, OAuth secrets, webhook
#     verification keys, JWKS endpoints pointing at a production issuer) are
#     EMPTY (`NAME=`) in this template.
#   * Non-secret defaults (timeouts, retry counts, ports, TTLs, log level,
#     provider choice, booleans) carry sane example values so a developer can
#     `cp .env.example .env` and start the service against local dependencies.
#   * Each group is preceded by a `# === Group X: Title ===` banner.
#   * Each variable carries an inline `# comment` describing its purpose.
#
# The authoritative configuration file for this service is
# `services/notification-service/config/default.yaml`. Values here override or
# supply secrets that must NOT live in `default.yaml` (per AAP R-25).
# =============================================================================


# =============================================================================
# Group A: Service Runtime
# =============================================================================
# Identity, listen port, environment classification, and log shape for the
# Notification Service process. These values are propagated into every log
# line and metric tag (per AAP R-26 — structured JSON logs include `service`).

# Logical service name embedded in every log line and metric tag (AAP R-26).
# MUST match the folder name `services/notification-service/` exactly.
SERVICE_NAME=notification-service

# HTTP listen port for the management API (`/health/live`, `/health/ready`,
# `/metrics`, template CRUD, delivery-log lookup). Must match the Dockerfile
# EXPOSE directive and the container's livenessProbe / readinessProbe httpGet
# port (AAP R-19).
SERVICE_PORT=8000

# Logical environment classifier — emitted as a tag on every log/metric.
# Allowed values: local | dev | stage | prod
ENVIRONMENT=local

# Log verbosity. Allowed values: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Log shape. Per AAP R-26 the platform standard is structured JSON with
# fields: timestamp, level, service, correlation_id, user_id, route,
# method, status, latency_ms, message. `json` is mandatory in non-local
# environments; `text` is permitted only for local debugging.
LOG_FORMAT=json


# =============================================================================
# Group B: Database — PostgreSQL (notification_db) — AAP Section 0.4.4
# =============================================================================
# The Notification Service owns its private `notification_db` PostgreSQL
# instance per AAP R-6 (database-per-service). Schema includes the four
# tables defined in AAP Section 0.4.4: `notification_log`, `delivery_attempts`,
# `templates`, and `user_channel_prefs`. No other service may read or write
# this database directly — all cross-service access happens via Kafka events.

# Full libpq connection URL — e.g.
#   postgresql://notification_user:<password>@notification-db:5432/notification_db
# EMPTY in this template; the real value is supplied by Vault / K8s Secret.
POSTGRES_URL=

# Minimum idle connections kept warm in the pool. Tuned to avoid cold-start
# latency for the first delivery attempt after a quiet period.
POSTGRES_POOL_MIN=2

# Maximum total connections the pool will open. Sized higher than read-side
# services because notification dispatch produces a sustained write workload
# (delivery_attempts inserts on every send + retry).
POSTGRES_POOL_MAX=20

# Per-statement server-side timeout (ms). Enforced via `SET statement_timeout`
# on connection checkout to bound worst-case query latency.
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# TCP / TLS handshake timeout when establishing a new connection.
POSTGRES_CONNECT_TIMEOUT_SECONDS=5


# =============================================================================
# Group C: Apache Kafka — AAP R-14, R-17, R-30
# =============================================================================
# The Notification Service is a TERMINAL CONSUMER (it produces no domain
# events). It subscribes to `user.registered`, `order.*`, and `payment.*`
# topics and routes failed dispatches to per-channel DLQ topics. All
# inbound events are validated against Schema Registry per AAP R-14.

# Comma-separated broker list, e.g. kafka-1:9092,kafka-2:9092,kafka-3:9092.
# EMPTY in this template; populated by Vault / K8s ConfigMap.
KAFKA_BOOTSTRAP=

# Consumer group identifier. Sharing a single group across all replicas
# spreads partitions evenly and ensures at-least-once delivery semantics.
KAFKA_GROUP_ID=notification-service

# Confluent Schema Registry URL used to validate every event payload
# (AAP R-14). EMPTY in this template; populated by Vault / K8s ConfigMap.
SCHEMA_REGISTRY_URL=

# Where to start consuming when no committed offset exists for the group.
# Allowed values: earliest | latest | none
KAFKA_AUTO_OFFSET_RESET=earliest

# Disable broker-side auto-commit so the service can commit ONLY after the
# downstream provider has accepted the notification. Combined with retry
# topics (R-17) this delivers at-least-once with exactly-one provider call.
KAFKA_ENABLE_AUTO_COMMIT=false

# Maximum records returned in a single poll() — bounds peak memory and the
# blast radius of a poison message before the consumer rebalances.
KAFKA_CONSUMER_MAX_POLL_RECORDS=50

# Time the broker waits for a heartbeat before declaring the consumer dead
# and triggering a rebalance.
KAFKA_SESSION_TIMEOUT_MS=30000

# Heartbeat interval the consumer sends to the group coordinator. Must be
# significantly less than KAFKA_SESSION_TIMEOUT_MS.
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# Suffix appended to a base topic to form its retry topic per AAP R-17,
# e.g. `order.created` -> `order.created.retry`. Failed messages are
# republished here with backoff metadata before final DLQ routing.
KAFKA_RETRY_TOPIC_SUFFIX=.retry

# Suffix appended to a base topic to form its dead-letter topic per AAP R-17,
# e.g. `order.created` -> `order.created.dlq`. Messages exhausting all
# retries are persisted here for human triage.
KAFKA_DLQ_TOPIC_SUFFIX=.dlq

# Maximum in-process retry attempts for a single message before it is
# routed to the retry topic. Aligns with AAP R-15 (bounded retry count).
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3

# Initial backoff between in-process retries. Combined with the per-channel
# exponential backoff for the actual provider HTTP call.
KAFKA_CONSUMER_RETRY_BACKOFF_MS=500

# -----------------------------------------------------------------------------
# Topics consumed (see config/default.yaml for the authoritative list):
#   - user.registered
#   - order.created
#   - order.cancelled
#   - order.fulfilled
#   - payment.succeeded
#   - payment.failed
#   - payment.refunded
#
# DLQ topics produced to:
#   - notifications.email.dlq
#   - notifications.sms.dlq
#   - <consumed-topic>.dlq (for poison messages)
#
# Producers of domain events: NONE (this service is a terminal consumer).
# -----------------------------------------------------------------------------


# =============================================================================
# Group D: Email Provider (SendGrid / AWS SES) — AAP Section 0.4.2, R-11
# =============================================================================
# The Notification Service implements the `NotificationChannel` adapter
# pattern (AAP R-11). Variables for BOTH SendGrid and AWS SES are declared
# below so operators can switch providers at runtime by setting
# `EMAIL_PROVIDER`. Only populate the credentials block for the active
# provider; leave the inactive block EMPTY.

# Active email provider adapter selector. Allowed values: sendgrid | aws_ses
EMAIL_PROVIDER=sendgrid

# Default verified `From:` address used when a template does not specify
# its own sender. EMPTY in this template; in production this must be a
# verified sender domain registered with the active provider.
EMAIL_FROM_ADDRESS=

# Friendly display name placed before the `From:` address on rendered
# emails. Visible to recipients in their inbox header.
EMAIL_FROM_NAME=E-Commerce Platform

# Optional `Reply-To:` header. Useful when transactional mail originates
# from a no-reply address but support replies are routed elsewhere.
EMAIL_REPLY_TO_ADDRESS=

# TCP / TLS handshake timeout when opening a connection to the provider
# REST endpoint.
EMAIL_CONNECT_TIMEOUT_MS=2000

# Maximum time to wait for the provider's HTTP response after the request
# headers have been sent.
EMAIL_READ_TIMEOUT_MS=5000

# Maximum total send attempts (initial + retries) per AAP R-15. Beyond
# this the message is published to `notifications.email.dlq`.
EMAIL_RETRY_MAX_ATTEMPTS=5

# Initial backoff before the first retry, in milliseconds. Combined with
# EMAIL_RETRY_MULTIPLIER and EMAIL_RETRY_JITTER_PCT to compute the
# effective sleep on each attempt.
EMAIL_RETRY_INITIAL_DELAY_MS=200

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15).
EMAIL_RETRY_MULTIPLIER=2.0

# Cap on the per-attempt backoff so the worker never sleeps for an
# unbounded duration even if the multiplier compounds.
EMAIL_RETRY_MAX_DELAY_MS=10000

# Jitter percentage added to each backoff value (uniform random in
# `[-jitter, +jitter]` * delay) to avoid thundering-herd retries
# across many workers (AAP R-15).
EMAIL_RETRY_JITTER_PCT=0.2

# Failure-rate threshold (percent) at which the email circuit breaker
# transitions from CLOSED to OPEN per AAP R-16.
EMAIL_CB_FAILURE_RATE_THRESHOLD=50

# Minimum number of calls in the rolling window before the circuit
# breaker can compute a meaningful failure rate.
EMAIL_CB_CALL_VOLUME_THRESHOLD=20

# Duration the circuit breaker remains OPEN before transitioning to
# HALF_OPEN to probe the upstream provider.
EMAIL_CB_OPEN_DURATION_MS=30000

# Number of probe calls permitted while the circuit breaker is in the
# HALF_OPEN state before deciding CLOSED vs OPEN.
EMAIL_CB_HALF_OPEN_PERMITTED_CALLS=1


# -----------------------------------------------------------------------------
# Group D.1: SendGrid-specific (when EMAIL_PROVIDER=sendgrid)
# -----------------------------------------------------------------------------
# Populate ONLY when EMAIL_PROVIDER=sendgrid. Leave EMPTY otherwise.

# SendGrid API key. SECRET — never commit. Rotate via SendGrid console.
SENDGRID_API_KEY=

# SendGrid REST API base URL. Pinned to v3; override only for staging
# sandboxes that proxy the API.
SENDGRID_BASE_URL=https://api.sendgrid.com/v3

# Public key used to verify the signature on inbound SendGrid event
# webhooks (delivered, bounced, opened, etc.). SECRET — never commit.
SENDGRID_WEBHOOK_VERIFICATION_KEY=


# -----------------------------------------------------------------------------
# Group D.2: AWS SES-specific (when EMAIL_PROVIDER=aws_ses)
# -----------------------------------------------------------------------------
# Populate ONLY when EMAIL_PROVIDER=aws_ses. Leave EMPTY otherwise.
# In Kubernetes, prefer IAM role assumption (IRSA) over long-lived static
# access keys; in that case leave AWS_SES_ACCESS_KEY_ID and
# AWS_SES_SECRET_ACCESS_KEY empty and rely on the pod's service account.

# AWS region of the SES service endpoint, e.g. us-east-1, ap-south-1.
AWS_REGION=us-east-1

# AWS access key ID for SES. SECRET — prefer IAM role assumption.
AWS_SES_ACCESS_KEY_ID=

# AWS secret access key for SES. SECRET — prefer IAM role assumption.
AWS_SES_SECRET_ACCESS_KEY=

# Optional SES configuration set name. When set, SES emits delivery
# events (bounces, complaints) to the configured CloudWatch / SNS sinks.
AWS_SES_CONFIGURATION_SET=


# =============================================================================
# Group E: SMS Provider (Twilio / AWS SNS) — AAP Section 0.4.2, R-11
# =============================================================================
# Mirrors Group D for the SMS channel. Variables for BOTH Twilio and AWS
# SNS are declared below so operators can switch providers at runtime by
# setting `SMS_PROVIDER`. Only populate the credentials block for the
# active provider; leave the inactive block EMPTY.

# Active SMS provider adapter selector. Allowed values: twilio | aws_sns
SMS_PROVIDER=twilio

# E.164-formatted sender phone number for Twilio (e.g. +15551234567) or
# alphanumeric sender ID for AWS SNS where supported. EMPTY in this
# template — populated per deployment.
SMS_FROM_NUMBER=

# TCP / TLS handshake timeout when opening a connection to the provider
# REST endpoint.
SMS_CONNECT_TIMEOUT_MS=2000

# Maximum time to wait for the provider's HTTP response after the request
# headers have been sent.
SMS_READ_TIMEOUT_MS=5000

# Maximum total send attempts (initial + retries) per AAP R-15. Beyond
# this the message is published to `notifications.sms.dlq`.
SMS_RETRY_MAX_ATTEMPTS=5

# Initial backoff before the first retry, in milliseconds.
SMS_RETRY_INITIAL_DELAY_MS=200

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15).
SMS_RETRY_MULTIPLIER=2.0

# Cap on the per-attempt backoff so the worker never sleeps for an
# unbounded duration even if the multiplier compounds.
SMS_RETRY_MAX_DELAY_MS=10000

# Jitter percentage added to each backoff value to avoid thundering-herd
# retries across many workers (AAP R-15).
SMS_RETRY_JITTER_PCT=0.2

# Failure-rate threshold (percent) at which the SMS circuit breaker
# transitions from CLOSED to OPEN per AAP R-16.
SMS_CB_FAILURE_RATE_THRESHOLD=50

# Minimum number of calls in the rolling window before the circuit
# breaker can compute a meaningful failure rate.
SMS_CB_CALL_VOLUME_THRESHOLD=20

# Duration the circuit breaker remains OPEN before transitioning to
# HALF_OPEN to probe the upstream provider.
SMS_CB_OPEN_DURATION_MS=30000

# Number of probe calls permitted while the circuit breaker is in the
# HALF_OPEN state before deciding CLOSED vs OPEN.
SMS_CB_HALF_OPEN_PERMITTED_CALLS=1


# -----------------------------------------------------------------------------
# Group E.1: Twilio-specific (when SMS_PROVIDER=twilio)
# -----------------------------------------------------------------------------
# Populate ONLY when SMS_PROVIDER=twilio. Leave EMPTY otherwise.

# Twilio Account SID (begins with "AC"). SECRET — never commit.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token paired with the Account SID. SECRET — never commit.
# Rotate via the Twilio console; revoke immediately if leaked.
TWILIO_AUTH_TOKEN=

# Twilio REST API base URL. Override only for staging sandboxes or for
# regional API endpoints (e.g. api.au1.twilio.com).
TWILIO_BASE_URL=https://api.twilio.com

# Optional Twilio Messaging Service SID (begins with "MG") used to enable
# carrier-aware sender pool routing, sticky sender assignment, and
# automatic compliance handling.
TWILIO_MESSAGING_SERVICE_SID=


# -----------------------------------------------------------------------------
# Group E.2: AWS SNS-specific (when SMS_PROVIDER=aws_sns)
# -----------------------------------------------------------------------------
# Populate ONLY when SMS_PROVIDER=aws_sns. Leave EMPTY otherwise.
# Note: AWS_REGION is shared with Group D.2 — set it once.

# AWS access key ID for SNS. SECRET — prefer IAM role assumption (IRSA).
AWS_SNS_ACCESS_KEY_ID=

# AWS secret access key for SNS. SECRET — prefer IAM role assumption.
AWS_SNS_SECRET_ACCESS_KEY=

# Alphanumeric sender ID displayed on recipient handsets in countries
# that support sender IDs (e.g. India, UK). Ignored elsewhere; SNS
# falls back to a long code or short code per region.
AWS_SNS_SENDER_ID=


# =============================================================================
# Group F: Authentication / JWT Validation — AAP R-21, R-22
# =============================================================================
# The Notification Service VALIDATES JWTs minted by the Auth Service. It
# is NEVER an issuer (per AAP R-21). Public keys are fetched from the
# Auth Service JWKS endpoint and cached with a bounded TTL (per AAP R-22).

# Base URL of the Auth Service. EMPTY in this template; populated per
# environment via Vault / K8s ConfigMap.
AUTH_SERVICE_URL=

# Full URL of the JWKS endpoint exposed by the Auth Service, e.g.
#   https://auth.example.com/.well-known/jwks.json
# EMPTY in this template — populated per environment.
JWT_PUBLIC_KEY_URL=

# Bounded TTL (seconds) for cached JWKS responses (AAP R-22). Aggressive
# caching reduces auth-service load; bounded TTL ensures key rotation
# propagates without service restart.
JWT_JWKS_CACHE_TTL_SECONDS=3600

# Expected `iss` (issuer) claim on every accepted JWT. EMPTY in this
# template; in production this is the canonical Auth Service issuer URL.
JWT_ISSUER=

# Expected `aud` (audience) claim on every accepted JWT. The Auth
# Service mints tokens with `aud=notification-service` for any caller
# attempting to invoke this service's management API.
JWT_AUDIENCE=notification-service


# =============================================================================
# Group G: Channel Routing Defaults — AAP R-11
# =============================================================================
# Channel selection is data-driven (AAP R-11) — these defaults are only
# consulted when a notification template or per-user preference is silent
# on the matter.

# Whether email is enabled by default for newly created notifications
# whose template does not specify channel routing.
CHANNEL_ROUTING_DEFAULT_EMAIL_ENABLED=true

# Whether SMS is enabled by default for newly created notifications.
# Off by default — SMS is opt-in for most events to avoid carrier costs
# and respect consent regulations (TCPA / GDPR / DND).
CHANNEL_ROUTING_DEFAULT_SMS_ENABLED=false

# Whether the dispatcher consults `user_channel_prefs` and respects user
# opt-outs. ALWAYS `true` in production; `false` only permitted in
# isolated test environments.
CHANNEL_ROUTING_RESPECT_USER_PREFS=true

# Whether notifications marked `critical=true` (e.g. payment.failed,
# security alerts) bypass user opt-out. Defaults to `true` — critical
# transactional notifications always reach the user.
CHANNEL_ROUTING_CRITICAL_OVERRIDES_OPT_OUT=true

# Start hour (0–23, local user time) of the quiet-hours window during
# which non-critical SMS is suppressed.
CHANNEL_ROUTING_QUIET_HOURS_LOCAL_START=22

# End hour (0–23, local user time) of the quiet-hours window. Wraps
# across midnight when end < start (default 22..7 = 9-hour quiet window).
CHANNEL_ROUTING_QUIET_HOURS_LOCAL_END=7

# Default locale used when a recipient has no `locale` attribute on
# their user profile. BCP 47 tag.
CHANNEL_ROUTING_DEFAULT_LOCALE=en-US


# =============================================================================
# Group H: Template Engine
# =============================================================================
# Notification body rendering uses a sandboxed template engine. Templates
# are stored in the `templates` table (AAP Section 0.4.4) and compiled
# into the in-process cache on first use.

# Active template engine. Allowed values: jinja2 | mustache.
# `jinja2` is the default and supports filters, macros, and inheritance.
TEMPLATE_ENGINE=jinja2

# Whether to cache compiled templates in-process. Disable only when
# debugging template hot-reload locally.
TEMPLATE_CACHE_ENABLED=true

# Maximum number of compiled templates retained in the LRU cache.
# Sized to comfortably hold every template variant (locale × channel).
TEMPLATE_CACHE_MAX_SIZE=500

# TTL (seconds) before a cached template is reloaded from the database.
# Bounded so template edits propagate without service restart.
TEMPLATE_CACHE_TTL_SECONDS=600

# Fail rendering with an explicit error when a template references a
# variable that was not supplied in the context. Production-grade
# safety: prevents shipping notifications with literal `{{var}}` tokens.
TEMPLATE_STRICT_UNDEFINED=true


# =============================================================================
# Group I: Retry Scheduler — AAP R-17
# =============================================================================
# The internal scheduler polls `delivery_attempts` for messages whose
# next-attempt timestamp has elapsed and re-dispatches them through the
# active provider. After SCHEDULER attempts exhaust the per-channel retry
# budget the message is routed to its DLQ.

# Master switch for the in-process retry scheduler. Disable only when
# running the service in a stateless mode driven entirely by Kafka retry
# topics (advanced deployment).
SCHEDULER_ENABLED=true

# Interval (ms) between scheduler poll cycles. Lower values reduce
# end-to-end retry latency; higher values reduce database load.
SCHEDULER_POLL_INTERVAL_MS=1000

# Maximum number of retry-eligible rows fetched per poll cycle.
SCHEDULER_BATCH_SIZE=50

# Maximum concurrent in-flight provider sends across the worker pool.
# Bounded to avoid exhausting the provider's per-account rate limit.
SCHEDULER_MAX_CONCURRENT_SENDS=10


# =============================================================================
# Group J: Observability — AAP R-26, R-27
# =============================================================================
# All structured JSON logs (AAP R-26) ship via Filebeat to Logstash
# (AAP R-27). Metrics expose on a separate port for Prometheus / Metricbeat
# scraping. OpenTelemetry traces are optional locally but mandatory in
# non-local environments.

# OpenTelemetry collector OTLP endpoint, e.g. http://otel-collector:4317
# Optional in local development; required in dev / stage / prod.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logical service name attached to every emitted span. Must match
# SERVICE_NAME for cross-correlation between logs and traces.
OTEL_SERVICE_NAME=notification-service

# HTTP port exposing the Prometheus metrics endpoint. Scraped by
# Metricbeat (per AAP R-27) and forwarded into Elasticsearch indices.
METRICS_PORT=9090

# Filesystem path where the service writes its rolling JSON log file
# when running outside Kubernetes. Inside Kubernetes leave EMPTY so the
# service writes to stdout and Filebeat harvests via the container
# runtime log driver.
FILEBEAT_PATH=


# =============================================================================
# Group K: HTTP Client General Configuration
# =============================================================================
# Default values applied to outbound HTTP calls that do not override them.
# Provider-specific overrides live in Groups D and E.

# User-Agent header sent on every outbound HTTP request. Aids upstream
# providers in identifying our traffic during incident triage.
HTTP_USER_AGENT=notification-service/1.0

# Default TCP / TLS handshake timeout for outbound HTTP calls without
# a more specific override.
HTTP_DEFAULT_CONNECT_TIMEOUT_MS=1000

# Default response read timeout for outbound HTTP calls without a more
# specific override.
HTTP_DEFAULT_READ_TIMEOUT_MS=5000


# =============================================================================
# IMPORTANT:
#   * Never commit real values for POSTGRES_URL, SENDGRID_API_KEY,
#     TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, AWS_*_KEY_* variables, or any
#     *_URL variable pointing at a production endpoint.
#   * JWT keys are fetched at runtime from JWT_PUBLIC_KEY_URL; no static
#     signing secret is required here (this service only VALIDATES JWTs).
#   * In Kubernetes, these values come from a ConfigMap (non-secret) plus a
#     Secret (credentials) pair; in production prefer IAM role assumption for
#     AWS providers over long-lived access keys.
#   * Provider selection happens via EMAIL_PROVIDER and SMS_PROVIDER; only
#     populate the credentials block for the active provider (leave the
#     inactive block empty).
# =============================================================================
