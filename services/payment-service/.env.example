# =============================================================================
# Payment Service — Environment Variable Template
# =============================================================================
# Copy this file to `.env` for local development and populate real values.
# Never commit real secrets to source control (see AAP R-25).
# In production, values are injected from Kubernetes Secrets / HashiCorp Vault
# / cloud secret manager; encryption keys are KMS-backed (see Group I).
#
# For local development, ONLY use Stripe TEST mode keys (sk_test_...) and
# Razorpay TEST mode keys. Using live keys for local dev is a SECURITY
# VIOLATION (AAP R-25 + folder spec encryption requirement).
# =============================================================================
#
# Per AAP R-25 (CRITICAL SECURITY RULE):
#   "Secrets must never appear in source or configuration files. Use Kubernetes
#    Secrets, Vault, or cloud provider secret managers; `.env.example` files
#    contain only variable names, never values."
#
# Per AAP R-8 (CRITICAL SECURITY RULE):
#   "Payment Service database must be encrypted at rest and must persist
#    idempotency keys for every outbound provider call to ensure safe retries
#    without duplicate charges."
#
# Per AAP R-10 (DUAL-PROVIDER REQUIREMENT):
#   "Both Stripe and Razorpay must be integrated concurrently behind a unified
#    PaymentProvider interface. Provider selection must be data-driven
#    (currency, region, merchant preference), not hard-coded."
#
# Conventions followed in this file:
#   * Variable names use SCREAMING_SNAKE_CASE exclusively.
#   * Sensitive variables (database URLs, API keys, webhook signing secrets,
#     KMS key references, JWKS endpoints pointing at a production issuer) are
#     EMPTY (`NAME=`) in this template.
#   * Non-secret defaults (timeouts, retry counts, ports, TTLs, log level,
#     provider choice, booleans) carry sane example values so a developer can
#     `cp .env.example .env` and start the service against local dependencies.
#   * Each group is preceded by a `# === Group X: Title ===` banner.
#   * Each variable carries an inline `# comment` describing its purpose.
#
# The authoritative configuration file for this service is
# `services/payment-service/config/default.yaml`. Values here override or
# supply secrets that must NOT live in `default.yaml` (per AAP R-25).
# =============================================================================


# =============================================================================
# Group A: Service Runtime
# =============================================================================
# Identity, listen port, environment classification, and log shape for the
# Payment Service process. These values are propagated into every log line
# and metric tag (per AAP R-26 — structured JSON logs include `service`).

# Logical service name embedded in every log line and metric tag (AAP R-26).
# MUST match the folder name `services/payment-service/` exactly.
SERVICE_NAME=payment-service

# HTTP listen port for the public API (charge / refund), webhook receivers,
# and admin endpoints (`/health/live`, `/health/ready`, `/metrics`).
# Must match the Dockerfile EXPOSE directive and the container's
# livenessProbe / readinessProbe httpGet port (AAP R-19).
SERVICE_PORT=8000

# HTTP listen port for inbound webhook callbacks from Stripe and Razorpay.
# Defaults to the same port as SERVICE_PORT — webhook receivers are mounted
# under `/webhooks/stripe` and `/webhooks/razorpay`. Operators MAY split
# webhooks onto a dedicated port via reverse proxy if network isolation
# (e.g., separate ingress class or distinct mTLS profile) is desired.
WEBHOOK_PORT=8000

# Logical environment classifier — emitted as a tag on every log/metric.
# Allowed values: local | dev | stage | prod
ENVIRONMENT=local

# Log verbosity. Allowed values: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Log shape. Per AAP R-26 the platform standard is structured JSON with
# fields: timestamp, level, service, correlation_id, user_id, route,
# method, status, latency_ms, message. `json` is mandatory in non-local
# environments; `text` is permitted only for local debugging.
LOG_FORMAT=json


# =============================================================================
# Group B: Database — PostgreSQL `payment_db` (encrypted at rest) — AAP R-8
# =============================================================================
# The Payment Service owns its private `payment_db` PostgreSQL instance per
# AAP R-6 (database-per-service). Schema includes the five tables defined
# in AAP Section 0.4.4: `payments`, `payment_attempts`, `refunds`,
# `provider_webhooks`, and `idempotency_keys`. The database MUST be
# encrypted at rest (AAP R-8) — column-level encryption for sensitive
# fields and storage-engine / volume-level encryption for the data files.
# No other service may read or write this database directly — all
# cross-service access happens via REST through the Payment Service API
# or via Kafka events.

# Full libpq connection URL — e.g.
#   postgresql://payment_user:<password>@payment-db:5432/payment_db
# EMPTY in this template; the real value is supplied by Vault / K8s Secret.
POSTGRES_URL=

# Minimum idle connections kept warm in the pool. Tuned to avoid cold-start
# latency for the first charge request after a quiet period.
POSTGRES_POOL_MIN=2

# Maximum total connections the pool will open. Sized to comfortably absorb
# burst traffic during checkout peaks while staying well below the database
# server's `max_connections` to leave headroom for migrations and admin tools.
POSTGRES_POOL_MAX=20

# Per-statement server-side timeout (ms). Enforced via `SET statement_timeout`
# on connection checkout to bound worst-case query latency for charge,
# refund, and idempotency-key lookup paths.
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# TCP / TLS handshake timeout when establishing a new connection.
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# Whether to require TLS on every Postgres connection. MUST be `true` in
# every non-local environment per AAP R-24 (all inter-service traffic must
# be TLS-encrypted). `false` is only acceptable for local Docker Compose.
POSTGRES_REQUIRE_TLS=true

# Optional path to a CA bundle (PEM) used to verify the Postgres server's
# TLS certificate. Leave EMPTY when the CA is the system trust store or
# when running locally without TLS. Required when POSTGRES_REQUIRE_TLS=true
# and the server uses a private CA.
POSTGRES_TLS_ROOT_CERT_PATH=


# =============================================================================
# Group C: Apache Kafka — AAP R-14, R-17, R-30
# =============================================================================
# The Payment Service consumes order lifecycle events to trigger captures
# and refunds, and produces payment outcome events for downstream consumers
# (Order Service, Notification Service, Recommendation Engine). All inbound
# events are validated against Schema Registry per AAP R-14; all produced
# events are versioned per AAP R-31.

# Comma-separated broker list, e.g. kafka-1:9092,kafka-2:9092,kafka-3:9092.
# EMPTY in this template; populated by Vault / K8s ConfigMap.
KAFKA_BOOTSTRAP=

# Consumer group identifier. Sharing a single group across all replicas
# spreads partitions evenly and ensures at-least-once delivery semantics.
KAFKA_GROUP_ID=payment-service

# Confluent Schema Registry URL used to validate every event payload
# (AAP R-14). EMPTY in this template; populated by Vault / K8s ConfigMap.
SCHEMA_REGISTRY_URL=

# Where to start consuming when no committed offset exists for the group.
# Allowed values: earliest | latest | none
KAFKA_AUTO_OFFSET_RESET=earliest

# Disable broker-side auto-commit so the service can commit ONLY after the
# downstream provider has accepted the charge / refund. Combined with retry
# topics (R-17) this delivers at-least-once with exactly-one provider call.
KAFKA_ENABLE_AUTO_COMMIT=false

# Maximum records returned in a single poll() — bounds peak memory and the
# blast radius of a poison message before the consumer rebalances.
KAFKA_CONSUMER_MAX_POLL_RECORDS=50

# Time the broker waits for a heartbeat before declaring the consumer dead
# and triggering a rebalance.
KAFKA_SESSION_TIMEOUT_MS=30000

# Heartbeat interval the consumer sends to the group coordinator. Must be
# significantly less than KAFKA_SESSION_TIMEOUT_MS.
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# Producer acknowledgement mode. `all` waits for the in-sync replica set to
# acknowledge each record — the strongest durability guarantee, mandatory
# for monetary events where data loss is unacceptable.
KAFKA_PRODUCER_ACKS=all

# Enable Kafka producer idempotence so a retried produce after broker ack
# loss does not result in duplicate event publication. Combined with
# `acks=all` this delivers exactly-once produce semantics within a session.
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# Suffix appended to a base topic to form its retry topic per AAP R-17,
# e.g. `order.created` -> `order.created.retry`. Failed messages are
# republished here with backoff metadata before final DLQ routing.
KAFKA_RETRY_TOPIC_SUFFIX=.retry

# Suffix appended to a base topic to form its dead-letter topic per AAP R-17,
# e.g. `order.created` -> `order.created.dlq`. Messages exhausting all
# retries are persisted here for human triage.
KAFKA_DLQ_TOPIC_SUFFIX=.dlq

# Maximum in-process retry attempts for a single message before it is
# routed to the retry topic. Aligns with AAP R-15 (bounded retry count).
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3

# Initial backoff between in-process retries. Combined with the per-provider
# exponential backoff for the actual provider HTTP call.
KAFKA_CONSUMER_RETRY_BACKOFF_MS=500

# -----------------------------------------------------------------------------
# Topics consumed (see config/default.yaml for the authoritative list):
#   - order.created       (capture trigger)
#   - order.cancelled     (refund trigger)
#
# Topics produced:
#   - payment.succeeded
#   - payment.failed
#   - payment.refunded
#
# DLQ topics produced to:
#   - payment.dlq                     (poison messages, signature failures, etc.)
#   - order.created.dlq               (consumed-event poison)
#   - order.cancelled.dlq             (consumed-event poison)
# -----------------------------------------------------------------------------


# =============================================================================
# Group D: Stripe Provider — AAP Section 0.4.2, R-10, R-12
# =============================================================================
# The Payment Service implements the `PaymentProvider` adapter pattern
# (AAP R-10). Stripe is the global / multi-currency provider; Razorpay
# (Group E) is the India-focused provider. BOTH adapters are concurrently
# wired — selection at request time is data-driven via Group F routing
# rules. Operators leave the inactive provider's secrets EMPTY and set
# `*_ENABLED=false` to disable a provider on a given deployment.

# Master switch enabling the Stripe adapter on this deployment. Set to
# `false` only when the entire deployment is single-provider on Razorpay.
STRIPE_ENABLED=true

# Stripe secret API key — formatted as `sk_test_...` for test mode and
# `sk_live_...` for production. SECRET — never commit. Local dev MUST use
# test keys only (live keys in a developer's `.env` is a SECURITY INCIDENT
# per the header banner above and AAP R-25).
STRIPE_API_KEY=

# Stripe REST API base URL. Pinned default; override only for proxied or
# mocked sandboxes during integration testing.
STRIPE_API_BASE_URL=https://api.stripe.com

# Stripe API version pinned at the request level. Pinning a known-good
# version prevents unexpected breaking changes when Stripe rolls out new
# API versions. Update this value (and re-test the test suite) as part of
# planned maintenance windows.
STRIPE_API_VERSION=2024-04-10

# Stripe webhook signing secret — formatted as `whsec_...`. Used to verify
# the HMAC signature on every inbound webhook (AAP R-12). SECRET — never
# commit. Each Stripe webhook endpoint has its own secret; rotate via the
# Stripe dashboard. Webhook signature verification is FAIL-CLOSED per
# Group H below.
STRIPE_WEBHOOK_SECRET=

# TCP / TLS handshake timeout when opening a connection to the Stripe API.
STRIPE_CONNECT_TIMEOUT_MS=2000

# Maximum time to wait for the Stripe API's HTTP response after the request
# headers have been sent.
STRIPE_READ_TIMEOUT_MS=10000

# Maximum total attempts (initial + retries) for any outbound Stripe call
# per AAP R-15. Beyond this the call is failed and the caller falls back
# (see Group F) or the message is routed to the retry / DLQ topic.
STRIPE_RETRY_MAX_ATTEMPTS=5

# Initial backoff before the first retry, in milliseconds. Combined with
# STRIPE_RETRY_MULTIPLIER and STRIPE_RETRY_JITTER_PCT to compute the
# effective sleep on each attempt.
STRIPE_RETRY_INITIAL_DELAY_MS=200

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15).
STRIPE_RETRY_MULTIPLIER=2.0

# Cap on the per-attempt backoff so the worker never sleeps for an
# unbounded duration even if the multiplier compounds.
STRIPE_RETRY_MAX_DELAY_MS=10000

# Jitter percentage added to each backoff value (uniform random in
# `[-jitter, +jitter]` * delay) to avoid thundering-herd retries
# across many workers (AAP R-15).
STRIPE_RETRY_JITTER_PCT=0.2

# Failure-rate threshold (percent) at which the Stripe circuit breaker
# transitions from CLOSED to OPEN per AAP R-16. Once OPEN, requests fail
# fast and Group F's fallback rules kick in to route to Razorpay where
# eligible.
STRIPE_CB_FAILURE_RATE_THRESHOLD=50

# Minimum number of calls in the rolling window before the circuit
# breaker can compute a meaningful failure rate.
STRIPE_CB_CALL_VOLUME_THRESHOLD=20

# Duration (ms) the circuit breaker remains OPEN before transitioning to
# HALF_OPEN to probe Stripe.
STRIPE_CB_OPEN_DURATION_MS=30000

# Number of probe calls permitted while the circuit breaker is in the
# HALF_OPEN state before deciding CLOSED vs OPEN.
STRIPE_CB_HALF_OPEN_PERMITTED_CALLS=1


# =============================================================================
# Group E: Razorpay Provider — AAP Section 0.4.2, R-10, R-12
# =============================================================================
# Razorpay is the India-focused provider. Mirrors Group D structurally so
# operators can reason about both providers symmetrically. BOTH adapters
# are concurrently wired (AAP R-10) — selection at request time is
# data-driven via Group F routing rules. Operators leave the inactive
# provider's secrets EMPTY and set `*_ENABLED=false` to disable.

# Master switch enabling the Razorpay adapter on this deployment. Set to
# `false` only when the entire deployment is single-provider on Stripe.
RAZORPAY_ENABLED=true

# Razorpay key id — typically formatted as `rzp_test_...` for test mode
# and `rzp_live_...` for production. SECRET — never commit. Local dev
# MUST use test keys only.
RAZORPAY_KEY_ID=

# Razorpay key secret paired with RAZORPAY_KEY_ID. SECRET — never commit.
# Rotate via the Razorpay dashboard; revoke immediately if leaked.
RAZORPAY_KEY_SECRET=

# Razorpay REST API base URL. Pinned default to the v1 API; override only
# for proxied or mocked sandboxes during integration testing.
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Razorpay webhook signing secret. Used to verify the HMAC signature on
# every inbound webhook (AAP R-12). SECRET — never commit. Each Razorpay
# webhook endpoint has its own secret; rotate via the Razorpay dashboard.
# Webhook signature verification is FAIL-CLOSED per Group H below.
RAZORPAY_WEBHOOK_SECRET=

# TCP / TLS handshake timeout when opening a connection to the Razorpay API.
RAZORPAY_CONNECT_TIMEOUT_MS=2000

# Maximum time to wait for the Razorpay API's HTTP response after the
# request headers have been sent.
RAZORPAY_READ_TIMEOUT_MS=10000

# Maximum total attempts (initial + retries) for any outbound Razorpay
# call per AAP R-15.
RAZORPAY_RETRY_MAX_ATTEMPTS=5

# Initial backoff before the first retry, in milliseconds.
RAZORPAY_RETRY_INITIAL_DELAY_MS=200

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15).
RAZORPAY_RETRY_MULTIPLIER=2.0

# Cap on the per-attempt backoff so the worker never sleeps for an
# unbounded duration even if the multiplier compounds.
RAZORPAY_RETRY_MAX_DELAY_MS=10000

# Jitter percentage added to each backoff value to avoid thundering-herd
# retries across many workers (AAP R-15).
RAZORPAY_RETRY_JITTER_PCT=0.2

# Failure-rate threshold (percent) at which the Razorpay circuit breaker
# transitions from CLOSED to OPEN per AAP R-16. Once OPEN, requests fail
# fast and Group F's fallback rules kick in to route to Stripe where
# eligible.
RAZORPAY_CB_FAILURE_RATE_THRESHOLD=50

# Minimum number of calls in the rolling window before the circuit
# breaker can compute a meaningful failure rate.
RAZORPAY_CB_CALL_VOLUME_THRESHOLD=20

# Duration (ms) the circuit breaker remains OPEN before transitioning to
# HALF_OPEN to probe Razorpay.
RAZORPAY_CB_OPEN_DURATION_MS=30000

# Number of probe calls permitted while the circuit breaker is in the
# HALF_OPEN state before deciding CLOSED vs OPEN.
RAZORPAY_CB_HALF_OPEN_PERMITTED_CALLS=1


# =============================================================================
# Group F: Provider Routing — AAP R-10 (data-driven, not hard-coded)
# =============================================================================
# Provider selection at request time is DATA-DRIVEN per AAP R-10. The
# routing strategy consults (in priority order):
#   1. Per-merchant pinning override (when RESPECT_MERCHANT_OVERRIDE=true)
#   2. Per-currency primary mapping (e.g. INR -> razorpay, USD -> stripe)
#   3. Default provider fallback when no rule matches
# When the primary provider's circuit breaker is OPEN and
# FALLBACK_ON_OPEN_CIRCUIT=true, the engine routes the request to the
# currency's configured fallback provider (if eligible).

# Global default provider used when no currency/merchant rule matches.
# Allowed values: stripe | razorpay
PROVIDER_ROUTING_DEFAULT_PROVIDER=stripe

# Primary provider for INR-denominated charges. Razorpay is preferred for
# India because it natively supports UPI, net banking, and Indian wallets.
PROVIDER_ROUTING_INR_PRIMARY=razorpay

# Fallback provider for INR when the primary's circuit breaker is OPEN.
# Stripe is the cross-border fallback; some Indian payment methods are not
# supported but card payments work as a last-resort.
PROVIDER_ROUTING_INR_FALLBACK=stripe

# Primary provider for USD-denominated charges. Stripe is preferred for
# global / USD because of broader currency and method coverage.
PROVIDER_ROUTING_USD_PRIMARY=stripe

# Fallback provider for USD. EMPTY by default — Razorpay's USD support is
# limited so we deliberately fail the request rather than silently fall
# back to a degraded code path. Set explicitly when broader fallback is
# required and the legal/regulatory implications are understood.
PROVIDER_ROUTING_USD_FALLBACK=

# Whether the routing engine should automatically fall back to the
# configured fallback provider when the primary's circuit breaker is OPEN
# (AAP R-16, R-20). MUST be `true` in production for high availability.
PROVIDER_ROUTING_FALLBACK_ON_OPEN_CIRCUIT=true

# Whether per-merchant `preferred_provider` settings (stored in the
# merchant configuration database / API) override the currency-based
# routing. ALWAYS `true` in production — merchants must be able to pin a
# provider for compliance, settlement, or commercial reasons.
PROVIDER_ROUTING_RESPECT_MERCHANT_OVERRIDE=true


# =============================================================================
# Group G: Idempotency — AAP R-8
# =============================================================================
# Every charge / refund call MUST be idempotent so safe retries (after
# network blips, ambiguous timeouts, or operator-driven replays) do not
# double-charge customers. The Payment Service:
#   1. Accepts an inbound `Idempotency-Key` header from the API Gateway.
#   2. Persists the key + request fingerprint in `payment_db.idempotency_keys`.
#   3. Forwards a derived idempotency key to the upstream provider so the
#      provider also rejects duplicates.
# Per AAP R-8 idempotency keys are persisted for safe replay.

# Inbound API header name carrying the client's idempotency key. Follows
# the IETF draft `Idempotency-Key` convention. Stripe and Razorpay both
# use the same header name for outbound provider calls.
IDEMPOTENCY_KEY_HEADER=Idempotency-Key

# How long (hours) a previously-seen idempotency key is remembered before
# the row is purged. 72 hours covers the typical provider retry / dispute
# window for transient failures while bounding storage growth.
IDEMPOTENCY_KEY_TTL_HOURS=72

# Hash algorithm used to fingerprint the request body so a replay with
# the same key but a different body is rejected (instead of being treated
# as a duplicate of the original). Allowed values: sha256 | sha512.
IDEMPOTENCY_REQUEST_HASH_ALGO=sha256

# Prefix prepended to keys forwarded to upstream providers. Helps trace
# the originating service in provider dashboards and logs (e.g.
# `psvc-<uuid>`). Must be short and ASCII-only.
IDEMPOTENCY_OUTBOUND_KEY_PREFIX=psvc-


# =============================================================================
# Group H: Webhook Verification — AAP R-12
# =============================================================================
# Inbound webhooks from Stripe and Razorpay MUST be cryptographically
# verified before any persisted state change (AAP R-12). The provider's
# signing secret (Group D / E) is combined with a tolerance window
# (replay protection) and a body-size guard (DoS hardening).

# Maximum allowed clock skew (seconds) between the webhook timestamp and
# the local clock. Webhooks older than this are rejected as replays.
# Stripe and Razorpay both recommend 300 seconds; do not raise without
# explicit security review.
WEBHOOK_TOLERANCE_SECONDS=300

# Maximum accepted webhook body size in bytes. Larger payloads are
# rejected before signature verification to mitigate DoS via oversized
# bodies. 256 KB comfortably accommodates the largest legitimate
# Stripe / Razorpay events.
WEBHOOK_MAX_BODY_BYTES=262144

# When `true`, signature-mismatch webhooks are dropped with a 200 OK
# response (so the provider does not retry) and a high-severity log entry
# is emitted; the message is NOT routed to a DLQ. When `false`, mismatched
# webhooks are quarantined for forensic review. Production default is
# `true` to prevent attackers from filling the DLQ with garbage events.
WEBHOOK_FAIL_FAST_ON_BAD_SIGNATURE=true


# =============================================================================
# Group I: Encryption at Rest — AAP R-8 (CRITICAL)
# =============================================================================
# Per AAP R-8 the Payment Service database MUST be encrypted at rest. This
# group selects the key-management backend and the columns that receive
# additional pgcrypto column-level encryption on top of volume-level
# encryption. Envelope encryption is used: a long-lived KMS-protected key
# encrypts short-lived data keys cached in-process for performance.

# Selects the key-management backend. Allowed values:
#   * local    — local AES-256 key file (LOCAL DEV ONLY)
#   * aws_kms  — AWS Key Management Service (KMS) with envelope encryption
#   * gcp_kms  — Google Cloud KMS
#   * vault    — HashiCorp Vault Transit secrets engine
# EMPTY in this template; populated per environment.
ENCRYPTION_PROVIDER=

# Reference (NOT the key itself) to the master key used to wrap envelope
# data keys — e.g. an AWS KMS key ARN, a GCP KMS key resource name, or a
# Vault Transit key path. SECRET (the reference may itself be sensitive).
# EMPTY in this template; populated per environment.
ENCRYPTION_KMS_KEY_ARN=

# Filesystem path to a local AES-256 key file. ONLY honored when
# ENCRYPTION_PROVIDER=local; ignored otherwise. NEVER use this in any
# non-local environment — it provides confidentiality only against
# casual database file access, not against compromise of the host.
ENCRYPTION_LOCAL_DEV_KEY_PATH=

# TTL (seconds) for cached envelope-encryption data keys. Short enough to
# bound key-rotation propagation; long enough to amortize KMS API calls
# across high-throughput charge/refund traffic.
ENCRYPTION_DATA_KEY_CACHE_TTL_SECONDS=300

# Comma-separated list of column names that receive pgcrypto column-level
# encryption on top of volume-level encryption. These columns hold
# sensitive metadata (last-four card digits, brand, holder name) that
# must remain protected even if a database backup is compromised. Raw
# PAN / CVV / track data is NEVER persisted (PCI-DSS scope reduction —
# see footer banner).
ENCRYPTED_COLUMNS=last4,brand,holder_name


# =============================================================================
# Group J: Authentication / JWT Validation — AAP R-21, R-22
# =============================================================================
# The Payment Service VALIDATES JWTs minted by the Auth Service. It is
# NEVER an issuer (per AAP R-21 — Auth Service is the sole issuer of JWT
# tokens). Public keys are fetched from the Auth Service JWKS endpoint
# and cached with a bounded TTL (per AAP R-22). Per-endpoint scope
# requirements enforce least-privilege access.

# Base URL of the Auth Service. EMPTY in this template; populated per
# environment via Vault / K8s ConfigMap.
AUTH_SERVICE_URL=

# Full URL of the JWKS endpoint exposed by the Auth Service, e.g.
#   https://auth.example.com/.well-known/jwks.json
# EMPTY in this template — populated per environment.
JWT_PUBLIC_KEY_URL=

# Bounded TTL (seconds) for cached JWKS responses (AAP R-22). Aggressive
# caching reduces auth-service load; bounded TTL ensures key rotation
# propagates without service restart.
JWT_JWKS_CACHE_TTL_SECONDS=3600

# Expected `iss` (issuer) claim on every accepted JWT. EMPTY in this
# template; in production this is the canonical Auth Service issuer URL.
JWT_ISSUER=

# Expected `aud` (audience) claim on every accepted JWT. The Auth
# Service mints tokens with `aud=payment-service` for any caller
# attempting to invoke this service's API.
JWT_AUDIENCE=payment-service

# OAuth scope required to invoke `POST /payments` (charge). Callers
# without this scope receive `403 Forbidden`.
JWT_REQUIRED_SCOPES_CHARGE=payments:charge

# OAuth scope required to invoke `POST /payments/{id}/refund`.
JWT_REQUIRED_SCOPES_REFUND=payments:refund

# OAuth scope required for admin endpoints (e.g.
# `GET /payments/{id}/attempts`, manual saga compensation).
JWT_REQUIRED_SCOPES_ADMIN=payments:admin


# =============================================================================
# Group K: Observability — AAP R-26, R-27
# =============================================================================
# All structured JSON logs (AAP R-26) ship via Filebeat to Logstash
# (AAP R-27). Metrics expose on a separate port for Prometheus / Metricbeat
# scraping. OpenTelemetry traces are optional locally but mandatory in
# non-local environments. Payment-specific PCI hygiene controls live in
# this group too — provider request/response bodies and PAN-like patterns
# must be redacted before logs leave the process.

# OpenTelemetry collector OTLP endpoint, e.g. http://otel-collector:4317
# Optional in local development; required in dev / stage / prod.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logical service name attached to every emitted span. Must match
# SERVICE_NAME for cross-correlation between logs and traces.
OTEL_SERVICE_NAME=payment-service

# HTTP port exposing the Prometheus metrics endpoint. Scraped by
# Metricbeat (per AAP R-27) and forwarded into Elasticsearch indices.
METRICS_PORT=9090

# Filesystem path where the service writes its rolling JSON log file
# when running outside Kubernetes. Inside Kubernetes leave EMPTY so the
# service writes to stdout and Filebeat harvests via the container
# runtime log driver.
FILEBEAT_PATH=

# When `true`, full provider request/response bodies are NOT logged —
# only redacted summaries (status code, latency, charge ID). Mandatory
# in production for PCI hygiene; setting `false` is permitted only in
# isolated local debugging sessions and must NEVER reach a non-local
# environment.
LOG_REDACT_PROVIDER_BODIES=true

# When `true`, fields matching PAN-like patterns (13–19 consecutive
# digits passing the Luhn check) are auto-redacted in every emitted log
# line. ALWAYS `true` in production — defense in depth even when
# LOG_REDACT_PROVIDER_BODIES is correctly enforced upstream.
LOG_PAN_REDACTION_ENABLED=true


# =============================================================================
# Group L: HTTP Client General Configuration
# =============================================================================
# Default values applied to outbound HTTP calls that do not override them.
# Provider-specific overrides live in Groups D and E.

# User-Agent header sent on every outbound HTTP request. Aids upstream
# providers in identifying our traffic during incident triage.
HTTP_USER_AGENT=payment-service/1.0

# Default TCP / TLS handshake timeout for outbound HTTP calls without
# a more specific override.
HTTP_DEFAULT_CONNECT_TIMEOUT_MS=2000

# Default response read timeout for outbound HTTP calls without a more
# specific override.
HTTP_DEFAULT_READ_TIMEOUT_MS=10000


# =============================================================================
# IMPORTANT (Payment Service has the strictest security posture):
#   * Never commit real values for STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET,
#     RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
#     POSTGRES_URL, ENCRYPTION_KMS_KEY_ARN, or any *_URL pointing at production.
#   * JWT keys are fetched at runtime from JWT_PUBLIC_KEY_URL; no static
#     signing secret is required here (this service only VALIDATES JWTs).
#   * In Kubernetes, these values come from a ConfigMap (non-secret) plus
#     Secret(s) and KMS key references; in production prefer IAM role
#     assumption + KMS over long-lived static keys.
#   * NEVER store raw card numbers / PAN / CVV / track data anywhere — only
#     provider-issued tokens (charge IDs, payment method IDs) and last4/brand
#     are persisted (PCI-DSS scope reduction). The application layer must
#     enforce this at write time.
#   * Webhook secrets (STRIPE_WEBHOOK_SECRET, RAZORPAY_WEBHOOK_SECRET) are
#     used for HMAC signature verification (AAP R-12); rotation procedure is
#     documented in docs/runbook/payment-service.md.
#   * For local development, ONLY Stripe TEST keys (sk_test_...) and Razorpay
#     TEST keys are acceptable. Live keys in a developer's .env is a SECURITY
#     INCIDENT.
# =============================================================================
