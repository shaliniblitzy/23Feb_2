{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "redact_pan": {
      "()": "src.observability.log_filters.PanRedactionFilter"
    },
    "redact_provider_bodies": {
      "()": "src.observability.log_filters.ProviderBodyRedactionFilter"
    }
  },
  "formatters": {
    "json": {
      "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
      "format": "%(asctime)s %(levelname)s %(name)s %(correlation_id)s %(user_id)s %(order_id)s %(payment_id)s %(provider)s %(attempt_no)s %(route)s %(method)s %(status)s %(latency_ms)s %(message)s",
      "rename_fields": {
        "levelname": "level",
        "asctime": "timestamp",
        "name": "service"
      },
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": ["redact_pan", "redact_provider_bodies"]
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "payment_service": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "confluent_kafka": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    },
    "sqlalchemy.engine": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    },
    "stripe": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    },
    "urllib3": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["stdout"],
    "level": "INFO"
  }
}
