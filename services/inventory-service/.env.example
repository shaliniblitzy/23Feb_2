# ============================================================================
# Inventory Service — .env.example
# ----------------------------------------------------------------------------
# Stock reservation engine and warehouse-state owner for the e-commerce
# platform. Owns inventory_db (PostgreSQL); produces inventory.reserved /
# inventory.released / inventory.low-stock; consumes order.created /
# order.cancelled / order.fulfilled.
#
# Architecture diagram: docs/architecture/system-diagram.md
# AAP refs: 0.1.1 #5, 0.4.2, 0.4.4, 0.5.2.5, 0.6.1, R-25
#
# USAGE:
#   1. cp .env.example .env
#   2. Fill in values for every key below. Defaults shown for non-secret
#      keys are safe placeholders; secrets MUST be sourced from Kubernetes
#      Secrets, Vault, or your cloud secret manager (AAP R-25).
#   3. Never commit your .env file. The .env file is .gitignore'd.
#
# CONVENTION:
#   - Non-secret defaults appear as KEY=value (the value is a recommended
#     default, free to override per environment).
#   - Secret keys appear as KEY= with NO VALUE; they MUST be set externally.
#   - Comments above each group explain its purpose.
# ============================================================================


# === Group A: Service Runtime ===
# Identity, listen ports, environment classification, and log shape for the
# Inventory Service process. SERVICE_NAME is propagated into every log line
# and metric tag (per AAP R-26 — structured JSON logs include `service`).
# Health-probe paths satisfy AAP R-19 (liveness + readiness probes).
SERVICE_NAME=inventory-service
SERVICE_PORT=8000
SERVICE_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_LIVENESS_PATH=/health/live
HEALTH_READINESS_PATH=/health/ready
METRICS_PORT=9090
METRICS_PATH=/metrics
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30


# === Group B: PostgreSQL — inventory_db ===
# Inventory Service owns inventory_db exclusively (AAP R-6). Tables:
# stock_items, reservations, warehouses, stock_movements (AAP Section 0.4.4).
# Optimistic locking via `stock_items.version` REQUIRES POSTGRES_LOCK_TIMEOUT_MS
# to bound contention; SELECT ... FOR UPDATE is bounded by
# POSTGRES_STATEMENT_TIMEOUT_MS.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_db
# Credentials — secrets, MUST be supplied via Kubernetes Secrets / Vault (AAP R-25):
POSTGRES_USER=
POSTGRES_PASSWORD=
# Computed convenience URL (some libraries expect a single URL form):
POSTGRES_URL=
POSTGRES_SSL_MODE=prefer
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20
POSTGRES_POOL_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=2000
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
POSTGRES_APPLICATION_NAME=inventory-service


# === Group C: Kafka — Producer & Consumer ===
# Inventory Service is BOTH consumer (order.* events from Order Service saga)
# AND producer (inventory.* events). Idempotent producer (AAP R-14) plus
# manual consumer commits (AAP R-17) form the exactly-once-effective pattern
# that DLQ routing requires.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_CLIENT_ID=inventory-service
KAFKA_GROUP_ID=inventory-service
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# When KAFKA_SECURITY_PROTOCOL=SASL_SSL, the next four are required:
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

# Consumer settings (AAP R-17 — manual commits + DLQ routing)
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_RECORDS=100

# Producer settings (AAP R-14 — idempotent producer)
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_COMPRESSION_TYPE=zstd
KAFKA_PRODUCER_LINGER_MS=10
KAFKA_PRODUCER_BATCH_SIZE=65536
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=30000

# Retry / DLQ topology (AAP R-17)
KAFKA_RETRY_TOPIC_SUFFIX=.retry
KAFKA_DLQ_TOPIC_SUFFIX=.dlq
KAFKA_RETRY_MAX_ATTEMPTS=5
KAFKA_RETRY_BACKOFF_INITIAL_MS=500
KAFKA_RETRY_BACKOFF_MAX_MS=30000
KAFKA_RETRY_BACKOFF_MULTIPLIER=2.0
KAFKA_RETRY_JITTER_MS=250


# === Group D: Schema Registry ===
# Confluent Schema Registry validates every event payload (AAP R-14) and
# enforces backward-compatible schema evolution (AAP R-33). The cache
# capacity bounds the in-memory schema cache to avoid unbounded growth.
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_AUTH_USERNAME=
SCHEMA_REGISTRY_AUTH_PASSWORD=
SCHEMA_REGISTRY_CACHE_CAPACITY=1000


# === Group E: Topic Names ===
# These names mirror the AAP Section 0.4.2 integration matrix verbatim —
# DO NOT rename without an event-catalog update across the monorepo.
# Per AAP R-30, topic names equal event names (<domain>.<verb>).

# Consumed (saga participant — AAP Section 0.4.2)
KAFKA_TOPIC_ORDER_CREATED=order.created
KAFKA_TOPIC_ORDER_CANCELLED=order.cancelled
KAFKA_TOPIC_ORDER_FULFILLED=order.fulfilled

# Produced (AAP Section 0.4.2; topic names == event names per AAP R-30)
KAFKA_TOPIC_INVENTORY_RESERVED=inventory.reserved
KAFKA_TOPIC_INVENTORY_RESERVATION_FAILED=inventory.reservation_failed
KAFKA_TOPIC_INVENTORY_RELEASED=inventory.released
KAFKA_TOPIC_INVENTORY_LOW_STOCK=inventory.low-stock

# DLQ (AAP R-17, AAP Section 0.4.2)
KAFKA_TOPIC_INVENTORY_DLQ=inventory.dlq


# === Group F: Reservation & Stock Policy ===
# Inventory-specific non-secret tunables. The reservation expiry scheduler
# is the primary fallback path (AAP R-20) for stuck sagas — without it, a
# Payment Service outage would freeze stock reservations indefinitely.
# Optimistic-lock retry knobs prevent thundering-herd amplification on
# contended SKUs under flash-sale conditions (AAP R-15).

# Default low-stock threshold; per-SKU overrides live in stock_items.low_stock_threshold (AAP Section 0.4.4)
LOW_STOCK_THRESHOLD_DEFAULT=10
# How long a reservation remains valid without order.fulfilled / order.cancelled before the
# expiration scheduler releases it (safety net for stuck sagas — AAP R-20)
RESERVATION_EXPIRY_MS=900000
RESERVATION_EXPIRY_SCHEDULER_POLL_INTERVAL_MS=60000
RESERVATION_EXPIRY_SCHEDULER_BATCH_SIZE=200
# Optimistic lock retry policy for reservation contention (AAP R-15)
STOCK_OPTIMISTIC_LOCK_MAX_RETRIES=5
STOCK_OPTIMISTIC_LOCK_BACKOFF_INITIAL_MS=25
STOCK_OPTIMISTIC_LOCK_BACKOFF_MAX_MS=500
STOCK_OPTIMISTIC_LOCK_JITTER_MS=10
# Default warehouse adapter when none specified on warehouses.adapter_type
DEFAULT_WAREHOUSE_ADAPTER=database


# === Group G: HTTP Client Resilience ===
# Currently no synchronous outbound HTTP from Inventory Service, but values
# are reserved for future warehouse adapters (e.g., External WMS HTTP calls).
# Granular timeouts (connect / read / total) make debugging hung calls
# dramatically easier than a single timeout knob (AAP R-15, R-16).
HTTP_CLIENT_CONNECT_TIMEOUT_MS=2000
HTTP_CLIENT_READ_TIMEOUT_MS=5000
HTTP_CLIENT_TOTAL_TIMEOUT_MS=10000
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_BACKOFF_INITIAL_MS=100
HTTP_CLIENT_BACKOFF_MAX_MS=2000
HTTP_CLIENT_BACKOFF_MULTIPLIER=2.0
HTTP_CLIENT_BACKOFF_JITTER_MS=50

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3


# === Group H: JWT / Auth ===
# JWT validation only — the Auth Service is the sole issuer (AAP R-21).
# JWKS is fetched from JWT_PUBLIC_KEY_URL and cached for
# JWT_JWKS_CACHE_TTL_SECONDS (AAP R-22). OAuth 2.0 scopes (AAP R-23)
# enforce coarse authorization: read scope for catalog browsing,
# admin scope for warehouse / stock-movement administration.
JWT_AUDIENCE=inventory-service
JWT_ISSUER=https://auth.example.com
JWT_PUBLIC_KEY_URL=https://auth.example.com/.well-known/jwks.json
JWT_JWKS_CACHE_TTL_SECONDS=3600
JWT_LEEWAY_SECONDS=30
JWT_REQUIRED_SCOPE_ADMIN=inventory:admin
JWT_REQUIRED_SCOPE_READ=inventory:read


# === Group I: Observability ===
# Correlation-ID middleware (AAP R-13) propagates X-Correlation-ID across
# every HTTP call and Kafka message header. Structured JSON logs (AAP R-26)
# are shipped via Filebeat to Logstash → Elasticsearch → Kibana (AAP R-27).
# OpenTelemetry exporter (optional) ships traces to a collector when
# OTEL_EXPORTER_OTLP_ENDPOINT is configured.
CORRELATION_ID_HEADER=X-Correlation-ID
CORRELATION_ID_REQUIRED=false
LOG_INCLUDE_REQUEST_BODY=false
LOG_INCLUDE_RESPONSE_BODY=false
LOG_REDACT_FIELDS=password,token,secret,authorization,cookie,api_key,apikey

# OpenTelemetry (optional but recommended)
OTEL_SERVICE_NAME=inventory-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_RESOURCE_ATTRIBUTES=service.name=inventory-service,service.namespace=ecommerce

# Prometheus (scraped by Metricbeat per AAP R-27)
PROMETHEUS_MULTIPROC_DIR=/app/tmp/prometheus


# === Group J: Feature Flags ===
# Operator-flippable switches. Disabling FEATURE_RESERVATION_EXPIRY_SCHEDULER_ENABLED
# turns off the saga-stuck safety net (AAP R-20); only do so when an external
# scheduler / cron job is taking over reservation expiry duty.
FEATURE_RESERVATION_EXPIRY_SCHEDULER_ENABLED=true
FEATURE_LOW_STOCK_EVENTS_ENABLED=true
FEATURE_STOCK_MOVEMENT_AUDIT_ENABLED=true
FEATURE_ADMIN_ENDPOINTS_ENABLED=true


# === Group K: Migrations ===
# Apply migrations on container startup (set to false in production; run via dedicated job)
RUN_MIGRATIONS_ON_STARTUP=true
MIGRATIONS_DIR=migrations


# ============================================================================
# End of .env.example — see config/default.yaml for the canonical mapping
# from environment variable to runtime config field. See README.md for the
# operational walkthrough.
# ============================================================================
