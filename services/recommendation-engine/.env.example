# =============================================================================
# Recommendation Engine — Environment Variable Template
# =============================================================================
# This file is a TEMPLATE. Copy it to `.env` for local development and populate
# real values out-of-band. `.env` is git-ignored.
#
# In non-local environments (dev / stage / prod) every value below is injected
# from a Kubernetes Secret + ConfigMap pair, HashiCorp Vault, or the equivalent
# cloud-provider secret manager. NEVER commit real values to source control.
#
# Per AAP R-25 (CRITICAL SECURITY RULE):
#   "Secrets must never appear in source or configuration files. Use Kubernetes
#    Secrets, Vault, or cloud provider secret managers; `.env.example` files
#    contain only variable names, never values."
#
# Conventions followed in this file:
#   * Variable names use SCREAMING_SNAKE_CASE exclusively.
#   * Sensitive variables (URLs to production endpoints, credentials, API keys,
#     JWKS endpoints, etc.) are EMPTY (`NAME=`) in this template.
#   * Non-secret defaults (timeouts, retry counts, ports, TTLs, log level,
#     embedding dim, top-K, booleans) carry sane example values.
#   * Each group is preceded by a `# === Group X: Title ===` banner.
#   * Each variable carries an inline `# comment` describing its purpose.
#
# The authoritative configuration file for this service is
# `services/recommendation-engine/config/default.yaml`. Values here override or
# supply secrets that must NOT live in `default.yaml` (per AAP R-25).
# =============================================================================


# =============================================================================
# Group A: Service Runtime
# =============================================================================
# Identity, listen port, environment classification, and log shape for the
# Recommendation Engine process. These values are propagated into every log
# line and metric tag (per AAP R-26 — structured JSON logs include `service`).

# Logical service name embedded in every log line and metric tag (AAP R-26).
# MUST match the folder name `services/recommendation-engine/` exactly.
SERVICE_NAME=recommendation-engine

# HTTP listen port for the inference API. Must match Dockerfile EXPOSE and
# the container's `livenessProbe` / `readinessProbe` httpGet port (AAP R-19).
SERVICE_PORT=8000

# Logical environment classifier — emitted as a tag on every log/metric.
# Allowed values: local | dev | stage | prod
ENVIRONMENT=local

# Log verbosity. Allowed values: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Log shape. Per AAP R-26 the platform standard is structured JSON with
# fields: timestamp, level, service, correlation_id, user_id, route,
# method, status, latency_ms, message. `json` is mandatory in non-local
# environments; `text` is permitted only for local debugging.
LOG_FORMAT=json


# =============================================================================
# Group B: Vector Store (pgvector / PostgreSQL) — AAP Section 0.4.4
# =============================================================================
# The Recommendation Engine owns its private database (per AAP R-6). Product
# and user embeddings are stored in a `pgvector`-enabled PostgreSQL instance
# named `recommendation_db`. No other service may read this database directly.

# Full libpq connection URL for the private vector store, e.g.
#   postgresql://reco_user:<password>@recommendation-vec:5432/recommendation_db
# EMPTY in this template — the real value is supplied by Vault / K8s Secret.
POSTGRES_URL=

# Minimum idle connections kept warm in the pool. Tuned to avoid cold-start
# latency on the first inference request after a quiet period.
POSTGRES_POOL_MIN=1

# Maximum total connections the pool will open against PostgreSQL.
# Sized to stay below the DB's `max_connections` minus headroom for peers.
POSTGRES_POOL_MAX=10

# Per-statement timeout (ms) enforced server-side via SET statement_timeout.
# Inference-path queries (vector similarity, popularity ranking) must complete
# below this threshold or be cancelled to protect the request's overall SLA.
POSTGRES_STATEMENT_TIMEOUT_MS=3000


# =============================================================================
# Group C: Redis Cache — AAP Section 0.4.4
# =============================================================================
# Redis caches materialized recommendation lists keyed by user_id and the
# popularity-fallback ranking. The cache also stores the JWKS document fetched
# from the Auth Service to amortize key-rotation overhead (AAP R-22).

# Full Redis connection URL, e.g. redis://recommendation-cache:6379/0
# EMPTY in this template — supplied at deploy time.
REDIS_URL=

# Default TTL (seconds) applied to cached recommendation lists.
# Below this threshold the cache is treated as authoritative; above it,
# the engine recomputes and refreshes the entry.
REDIS_CACHE_TTL_SECONDS=600

# Connect timeout (ms) before Redis is considered unavailable. On timeout
# the engine degrades to the in-process fallback path (AAP R-20).
REDIS_CONNECT_TIMEOUT_MS=2000


# =============================================================================
# Group D: Apache Kafka — AAP R-14, R-17, R-30
# =============================================================================
# Kafka is the asynchronous event backbone (per AAP). The Recommendation
# Engine is a TERMINAL CONSUMER of domain events — it does not produce any
# events of its own. Every message it consumes is validated against the
# Schema Registry contract (AAP R-14) before processing.

# Comma-separated list of Kafka bootstrap servers, e.g.
#   kafka-1:9092,kafka-2:9092,kafka-3:9092
# EMPTY in this template — supplied per-environment.
KAFKA_BOOTSTRAP=

# Consumer group identifier. All replicas of the Recommendation Engine
# share this group so partitions are distributed across pods.
KAFKA_GROUP_ID=recommendation-engine

# Confluent Schema Registry URL used to look up Avro / JSON-Schema by ID.
# EMPTY in this template — supplied per-environment.
SCHEMA_REGISTRY_URL=

# Behavior when no committed offset exists for the consumer group.
# `earliest` is correct for analytics-style consumers that must back-fill
# all historical events on first deployment.
KAFKA_AUTO_OFFSET_RESET=earliest

# Disable broker-driven auto-commit. Per at-least-once semantics, offsets
# are committed manually only after a record has been successfully
# processed (vector indexed, cache invalidated, etc.).
KAFKA_ENABLE_AUTO_COMMIT=false

# Maximum records returned by a single poll() call. Keep small enough to
# bound the worst-case rebalance time and per-batch processing latency.
KAFKA_CONSUMER_MAX_POLL_RECORDS=100

# Suffix appended to a topic name to produce its retry partner topic.
# Final form: `<original-topic><KAFKA_RETRY_TOPIC_SUFFIX>` (AAP R-17).
KAFKA_RETRY_TOPIC_SUFFIX=.retry

# Suffix appended to a topic name to produce its dead-letter partner topic.
# Final form: `<original-topic><KAFKA_DLQ_TOPIC_SUFFIX>` (AAP R-17).
KAFKA_DLQ_TOPIC_SUFFIX=.dlq

# Maximum redelivery attempts before a poison message is forwarded to the
# topic's DLQ partner. Each attempt waits KAFKA_CONSUMER_RETRY_BACKOFF_MS
# multiplied by the attempt number (linear backoff with jitter).
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3

# Initial backoff (ms) between retry attempts at the consumer level.
KAFKA_CONSUMER_RETRY_BACKOFF_MS=500

# -----------------------------------------------------------------------------
# Topics consumed (see config/default.yaml for the authoritative list):
#   - product.created       (refresh embedding for new product)
#   - product.updated       (re-embed mutated product)
#   - order.created         (record interaction signal)
#   - order.fulfilled       (boost popularity score)
#   - user.registered       (cold-start profile bootstrap)
#   - user.updated          (re-embed mutated user preferences)
# Producers: NONE (the Recommendation Engine is a terminal consumer)
# -----------------------------------------------------------------------------


# =============================================================================
# Group E: Product Service Client — AAP Section 0.4.2
# =============================================================================
# The Recommendation Engine calls the Product Service synchronously to fetch
# product metadata for hydrating recommendation responses. Per AAP R-15 every
# outbound HTTP call carries a retry policy; per AAP R-16 every call site is
# protected by a circuit breaker. On open-circuit, the engine degrades to the
# popularity-based fallback (AAP R-20, "ML miss → popularity fallback").

# Base URL of the Product Service, e.g. http://product-service:8080
# EMPTY in this template — supplied per-environment.
PRODUCT_SERVICE_URL=

# TCP connect timeout (ms) for the Product Service HTTP client.
PRODUCT_SERVICE_CONNECT_TIMEOUT_MS=1000

# Read (response) timeout (ms) for the Product Service HTTP client.
PRODUCT_SERVICE_READ_TIMEOUT_MS=2000

# --- Retry policy (AAP R-15) ---
# Maximum total attempts (initial + retries) for an idempotent call.
PRODUCT_SERVICE_RETRY_MAX_ATTEMPTS=3

# Initial backoff (ms) before the first retry.
PRODUCT_SERVICE_RETRY_INITIAL_DELAY_MS=100

# Multiplier applied to the backoff between attempts (exponential backoff).
PRODUCT_SERVICE_RETRY_MULTIPLIER=2.0

# Cap on the backoff so retries never sleep for an unbounded duration.
PRODUCT_SERVICE_RETRY_MAX_DELAY_MS=2000

# --- Circuit breaker policy (AAP R-16) ---
# Failure-rate (percent) within the rolling window required to OPEN the
# breaker. Once OPEN, calls short-circuit and the fallback path is used.
PRODUCT_SERVICE_CB_FAILURE_RATE_THRESHOLD=50

# Minimum number of calls required in the rolling window before the
# failure-rate threshold is evaluated (avoids tripping on tiny samples).
PRODUCT_SERVICE_CB_CALL_VOLUME_THRESHOLD=20

# Duration (ms) the breaker stays OPEN before a single probe is allowed
# (transition to HALF_OPEN).
PRODUCT_SERVICE_CB_OPEN_DURATION_MS=30000

# Maximum concurrent probe calls allowed in the HALF_OPEN state.
PRODUCT_SERVICE_CB_HALF_OPEN_PERMITTED_CALLS=1


# =============================================================================
# Group F: Authentication / JWT Validation — AAP R-21, R-22, R-23
# =============================================================================
# The Recommendation Engine VALIDATES incoming JWTs but never issues them
# (AAP R-21 — the Auth Service is the sole token issuer). Validation keys
# are fetched at runtime from the Auth Service's JWKS endpoint and cached
# with a bounded TTL (AAP R-22). No static signing secret is required here.

# Base URL of the Auth Service, e.g. http://auth-service:8080
# EMPTY in this template — supplied per-environment.
AUTH_SERVICE_URL=

# JWKS endpoint published by the Auth Service. Recommended form:
#   ${AUTH_SERVICE_URL}/.well-known/jwks.json
# EMPTY in this template — derived per-environment from AUTH_SERVICE_URL.
JWT_PUBLIC_KEY_URL=

# JWKS document cache TTL (seconds). Bounded per AAP R-22 so key rotation
# in the Auth Service is picked up without restarting this service.
JWT_JWKS_CACHE_TTL_SECONDS=3600

# Expected `iss` (issuer) claim on incoming JWTs, e.g.
#   https://auth.example.com
# EMPTY in this template — supplied per-environment.
JWT_ISSUER=

# Expected `aud` (audience) claim on incoming JWTs. The Recommendation
# Engine rejects tokens whose `aud` does not contain this value.
JWT_AUDIENCE=recommendation-engine


# =============================================================================
# Group G: ML Model Configuration
# =============================================================================
# Configuration for the locally-mounted ML model that powers personalized
# recommendations. The Recommendation Engine is the ONLY service in the
# platform that loads serialized ML artifacts at boot time.

# Filesystem path to the serialized model artifacts (directory or single
# file, depending on the runtime). In Docker / Kubernetes this path is
# typically a mounted volume populated by a model-publish job.
MODEL_PATH=./models/latest

# Identifier of the loaded model — semantic version, git SHA, or content
# hash. Emitted on every inference log line so a recommendation can be
# traced back to the exact model that produced it.
# EMPTY in this template — populated by the model-publish job.
MODEL_VERSION=

# Default number of recommendations returned when the caller does not
# specify a `top_k` query parameter.
MODEL_TOP_K=20

# Dimensionality of user / product embedding vectors. MUST match the
# `pgvector` column dimension defined in the migration that creates the
# `embeddings` table. Mismatch causes inference to fail at startup.
MODEL_EMBEDDING_DIM=128

# Run a dummy inference at boot to prime tensors, JIT-compile graphs, and
# warm connection pools before the readiness probe reports `ready` (AAP
# R-19). Disable only for unit-test execution where speed beats warmth.
MODEL_WARMUP_ON_STARTUP=true


# =============================================================================
# Group H: Fallback Thresholds — AAP R-20, Section 0.4.2
# =============================================================================
# Tiered fallback strategy when the inference path cannot produce a
# high-confidence recommendation. Order of precedence:
#   1. Inference result (above MIN_INFERENCE_CONFIDENCE).
#   2. Cached result in Redis (if FALLBACK_CACHE_MISS_ENABLED).
#   3. Popularity-based ranking (if FALLBACK_POPULARITY_ENABLED).
#   4. Empty list (caller-side default applies).

# When true, on inference miss / low confidence, consult Redis for a
# previously-materialized list before falling back to popularity ranking.
FALLBACK_CACHE_MISS_ENABLED=true

# When true, fall back to popularity-based recommendations as the final
# tier. AAP Section 0.4.2 calls out "ML miss → popularity fallback" as a
# first-class requirement.
FALLBACK_POPULARITY_ENABLED=true

# How often (seconds) the popularity ranking is recomputed from
# `order.fulfilled` events and persisted to Redis. Set lower than the
# typical traffic burst window to avoid stale rankings.
FALLBACK_POPULARITY_REFRESH_INTERVAL_SECONDS=300

# Rolling window (days) used to compute popularity scores. Longer windows
# smooth out short-term spikes; shorter windows surface trending items.
FALLBACK_POPULARITY_WINDOW_DAYS=30

# Minimum model-confidence score required before an inference result is
# returned to the caller. Below this threshold the engine falls through
# to the cache tier (and then the popularity tier).
FALLBACK_MIN_INFERENCE_CONFIDENCE=0.3


# =============================================================================
# Group I: Observability — AAP R-26, R-27
# =============================================================================
# Logs, metrics, and traces feed into the central ELK + OpenTelemetry stack.
# Per AAP R-27, all services ship logs via Filebeat and metrics via
# Metricbeat; per AAP R-26 every log line is structured JSON.

# OpenTelemetry collector OTLP endpoint, e.g. http://otel-collector:4317
# EMPTY in this template — supplied per-environment. Optional in `local`.
OTEL_EXPORTER_OTLP_ENDPOINT=

# `service.name` resource attribute applied to every emitted span / metric.
# MUST match SERVICE_NAME above so traces correlate with logs.
OTEL_SERVICE_NAME=recommendation-engine

# Prometheus-format metrics endpoint port. Scraped by Metricbeat (per AAP
# R-27) and surfaced in the Recommendation domain Kibana dashboard.
METRICS_PORT=9090

# Filesystem path Filebeat is configured to harvest for this container's
# logs. Leave EMPTY if the service is configured to write logs to stdout
# (the recommended container default — Filebeat picks up the container
# log file via the Docker / containerd collector instead).
FILEBEAT_PATH=


# =============================================================================
# Group J: HTTP Client General Configuration
# =============================================================================
# Defaults inherited by every outbound HTTP client (Product Service, Auth
# Service JWKS fetch, OpenTelemetry exporter when HTTP is selected).
# Per-call-site overrides take precedence over these defaults.

# User-Agent header sent on every outbound HTTP request.
HTTP_USER_AGENT=recommendation-engine/1.0

# Default TCP connect timeout (ms) for any outbound HTTP client without
# its own timeout configuration.
HTTP_DEFAULT_CONNECT_TIMEOUT_MS=1000

# Default response (read) timeout (ms) for any outbound HTTP client
# without its own timeout configuration.
HTTP_DEFAULT_READ_TIMEOUT_MS=3000


# =============================================================================
# IMPORTANT — operational reminders (per AAP R-25)
# =============================================================================
#   * Never commit real values for POSTGRES_URL, REDIS_URL, KAFKA_BOOTSTRAP,
#     SCHEMA_REGISTRY_URL, AUTH_SERVICE_URL, JWT_PUBLIC_KEY_URL, JWT_ISSUER,
#     PRODUCT_SERVICE_URL, OTEL_EXPORTER_OTLP_ENDPOINT, MODEL_VERSION, or any
#     other variable left intentionally EMPTY in this template.
#   * JWT public keys are fetched at runtime from JWT_PUBLIC_KEY_URL and
#     cached for JWT_JWKS_CACHE_TTL_SECONDS. The Recommendation Engine only
#     VALIDATES JWTs (AAP R-21); no static signing secret is required.
#   * In Kubernetes, non-secret values come from a ConfigMap and secret
#     values come from a Secret; both are projected into the Pod's
#     environment via `envFrom`.
#   * The authoritative non-secret defaults live in
#     `services/recommendation-engine/config/default.yaml`. Values in this
#     file override defaults at runtime via the standard env-var precedence.
# =============================================================================
