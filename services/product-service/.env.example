# =============================================================================
# Product Service — Environment Variable Template
# =============================================================================
# Copy this file to `.env` for local development and populate real values.
# Never commit real secrets to source control (see AAP R-25).
# In production, values are injected from Kubernetes Secrets / HashiCorp Vault.
# =============================================================================
#
# Per AAP R-25 (CRITICAL SECURITY RULE):
#   "Secrets must never appear in source or configuration files. Use Kubernetes
#    Secrets, Vault, or cloud provider secret managers; `.env.example` files
#    contain only variable names, never values."
#
# Per AAP R-7 (POLYGLOT PERSISTENCE):
#   "Choose the most appropriate persistence per service. ... MongoDB for
#    flexible schemas (Product) ..." — this service is the only Python
#    service in the monorepo that is backed by MongoDB; sibling services
#    (auth, user, inventory, order, payment, notification) use PostgreSQL.
#    DO NOT copy this file's database group to those services.
#
# Per AAP R-21 (JWT ISSUER UNIQUENESS):
#   "The Auth Service is the sole issuer of JWT tokens. No other service may
#    mint tokens; all other services only validate JWTs issued by Auth
#    Service." — this service therefore declares ONLY validation variables
#    (JWKS endpoint, expected `iss` / `aud` claims, scope requirements);
#    no signing-key variable exists in this template.
#
# Conventions followed in this file:
#   * Variable names use SCREAMING_SNAKE_CASE exclusively.
#   * Sensitive variables (database URLs, API keys, OAuth secrets, JWKS
#     endpoints pointing at a production issuer) are EMPTY (`NAME=`) in
#     this template.
#   * Non-secret defaults (timeouts, retry counts, ports, TTLs, log level,
#     booleans) carry sane example values so a developer can
#     `cp .env.example .env` and start the service against local dependencies.
#   * Each group is preceded by a `# === Group X: Title ===` banner.
#   * Each variable carries an inline `# comment` describing its purpose.
#   * Groups are ordered logically:
#         runtime -> database -> kafka -> catalog -> idempotency
#         -> http -> auth -> observability -> features.
#
# The authoritative configuration file for this service is
# `services/product-service/config/default.yaml`. Values here override or
# supply secrets that must NOT live in `default.yaml` (per AAP R-25).
# =============================================================================


# =============================================================================
# Group A: Service Runtime
# =============================================================================
# Identity, listen port, environment classification, log shape, and health
# probe paths for the Product Service process. These values are propagated
# into every log line and metric tag (per AAP R-26 — structured JSON logs
# include `service`).

# Logical service name embedded in every log line and metric tag (AAP R-26).
# MUST match the folder name `services/product-service/` exactly. Used by
# the API Gateway routing layer, by Filebeat for log enrichment, and by
# OpenTelemetry as the default `service.name` resource attribute.
SERVICE_NAME=product-service

# HTTP listen port for the public read API (`GET /products`,
# `GET /products/{id}`, `GET /categories`, search), the admin write API
# (`POST/PUT/DELETE /products`, `POST/PUT/DELETE /categories`), and the
# operational endpoints (`/health/live`, `/health/ready`, `/metrics`).
# Must match the Dockerfile EXPOSE directive and the container's
# livenessProbe / readinessProbe httpGet port (AAP R-19).
SERVICE_PORT=8000

# Logical environment classifier — emitted as a tag on every log/metric.
# Allowed values: local | dev | stage | prod
ENVIRONMENT=local

# Log verbosity. Allowed values: DEBUG | INFO | WARN | ERROR
# `DEBUG` is permitted only for local debugging; `INFO` is the default in
# all non-local environments. Higher levels (WARN, ERROR) reduce log volume
# and ELK ingestion cost when noise must be suppressed.
LOG_LEVEL=INFO

# Log shape. Per AAP R-26 the platform standard is structured JSON with
# fields: timestamp, level, service, correlation_id, user_id, route,
# method, status, latency_ms, message. `json` is mandatory in non-local
# environments; `text` is permitted only for local debugging.
LOG_FORMAT=json

# Path served by the liveness probe (AAP R-19). Returns `200 OK` when the
# process is running and the event loop is responsive. The Kubernetes
# kubelet calls this endpoint and restarts the pod on repeated failure.
HEALTH_LIVENESS_PATH=/health/live

# Path served by the readiness probe (AAP R-19). Returns `200 OK` only
# after the MongoDB connection pool is established, the Kafka producer
# has been initialized, and the JWKS cache has been primed. Returns
# `503 Service Unavailable` during startup or when a critical dependency
# is degraded — kubelet will withhold traffic from this pod until ready.
HEALTH_READINESS_PATH=/health/ready


# =============================================================================
# Group B: Database — MongoDB (`product_db`) — AAP Section 0.4.4, R-7
# =============================================================================
# The Product Service owns its private `product_db` MongoDB instance per
# AAP R-6 (database-per-service). Schema includes the three collections
# defined in AAP Section 0.4.4: `products`, `categories`, and
# `product_media`. MongoDB was chosen per AAP R-7 because product
# attributes vary widely across categories (apparel sizes vs. electronics
# specs vs. groceries shelf-life), and a flexible document schema avoids
# the migration churn of a wide relational table. No other service may
# read or write this database directly — all cross-service access happens
# via this service's REST API or via Kafka events.

# Full MongoDB connection URI — e.g.
#   mongodb://product_user:<password>@product-db-0:27017,product-db-1:27017,product-db-2:27017/?replicaSet=rs0&tls=true&authSource=admin
# EMPTY in this template; the real value is supplied by Vault / K8s Secret.
# Use a replica set URI in every non-local environment so the driver can
# failover automatically when the primary is rotated.
MONGODB_URL=

# Logical database name within the MongoDB cluster. Non-secret — declared
# here so operators do not have to encode it inside MONGODB_URL and so
# integration tests can target a per-test ephemeral database.
MONGODB_DATABASE=product_db

# Minimum idle connections kept warm in the driver pool. Tuned to avoid
# cold-start latency on the first read after a quiet period.
MONGODB_MIN_POOL_SIZE=2

# Maximum total connections the driver pool will open. Sized to absorb
# burst read traffic during catalog browse spikes while staying well
# below the MongoDB server's `connections.current` ceiling.
MONGODB_MAX_POOL_SIZE=50

# TCP / TLS handshake timeout (ms) when establishing a new connection
# to a MongoDB host.
MONGODB_CONNECT_TIMEOUT_MS=5000

# Per-operation socket timeout (ms). Bounds worst-case query latency for
# slow aggregation pipelines (faceted search, category tree builds).
MONGODB_SOCKET_TIMEOUT_MS=10000

# How long (ms) the driver will wait for a primary to become available
# during a replica-set election before failing the request. Aligns with
# the Kubernetes pod readiness window so we fail fast rather than
# accumulating queued requests behind a stalled primary.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Driver-level retry for transient write failures (network blips,
# step-down during election). Aligns with AAP R-15 (retries with backoff)
# at the driver layer; our application layer adds idempotency keys for
# admin writes (Group E) so retries are safe against duplicate effects.
MONGODB_RETRY_WRITES=true

# Driver-level retry for transient read failures. MongoDB 4.4+ default;
# explicitly declared here so behavior is unambiguous across deployments.
MONGODB_RETRY_READS=true

# Read preference for queries. `primaryPreferred` reads from primary when
# available and falls back to a secondary on outage — gives bounded
# staleness during a primary failover without violating consistency for
# the common case. Allowed values: primary | primaryPreferred |
# secondary | secondaryPreferred | nearest.
MONGODB_READ_PREFERENCE=primaryPreferred

# Write concern for inserts and updates. `majority` requires
# acknowledgement from the majority of replica-set members before the
# driver returns success — strongest durability guarantee for catalog
# changes that fan out as `product.*` Kafka events.
MONGODB_WRITE_CONCERN=majority

# Whether to require TLS on every MongoDB connection. MUST be `true` in
# every non-local environment per AAP R-24 (all inter-service traffic
# must be TLS-encrypted). `false` is only acceptable for local Docker
# Compose where the MongoDB container is on a private bridge network.
MONGODB_TLS_ENABLED=true

# Optional path to a CA bundle (PEM) used to verify the MongoDB server's
# TLS certificate. Leave EMPTY when the CA is the system trust store or
# when running locally without TLS. Required when MONGODB_TLS_ENABLED=true
# and the server uses a private CA (e.g., AWS DocumentDB, in-cluster cert
# manager).
MONGODB_TLS_CA_FILE=

# Identifies this client in MongoDB server logs (`appName` field on
# `db.currentOp()` and on slow-query logs). Aids upstream operators in
# attributing traffic during incident triage.
MONGODB_APP_NAME=product-service


# =============================================================================
# Group C: Apache Kafka — AAP R-14, R-17, R-30
# =============================================================================
# The Product Service is a PURE EVENT PRODUCER (it does not consume any
# Kafka topics — see the topic block below). It publishes
# `product.created` and `product.updated` events on every successful
# admin write. All produced events are validated against Schema Registry
# (AAP R-14) before being sent and are versioned per AAP R-31. Publication
# failures (broker outage, schema-validation failure) are routed to the
# corresponding `<topic>.dlq` after exhausting the retry budget per
# AAP R-17.

# Comma-separated broker list, e.g. kafka-1:9092,kafka-2:9092,kafka-3:9092.
# EMPTY in this template; populated by Vault / K8s ConfigMap.
KAFKA_BOOTSTRAP=

# Producer `client.id` reported to the broker. Helps operators correlate
# producer-side metrics (records/sec, error rate, request latency) with
# this specific service when reviewing broker telemetry.
KAFKA_CLIENT_ID=product-service

# Confluent Schema Registry URL used to validate every produced event
# payload against its registered Avro / JSON schema (AAP R-14).
# EMPTY in this template; populated by Vault / K8s ConfigMap.
SCHEMA_REGISTRY_URL=

# Optional Basic auth credential for Schema Registry in `user:password`
# form. EMPTY in this template; populated by Vault / K8s Secret when the
# Schema Registry deployment requires authentication. Leave EMPTY for
# anonymous (private network) deployments.
SCHEMA_REGISTRY_AUTH=

# Producer acknowledgement mode. `all` waits for the in-sync replica set
# to acknowledge each record — the strongest durability guarantee.
# Mandatory for `product.*` events because downstream consumers
# (Recommendation Engine, Inventory Service) treat the catalog as the
# authoritative source for product metadata.
KAFKA_PRODUCER_ACKS=all

# Enable Kafka producer idempotence so a retried produce after broker
# ack loss does not result in duplicate event publication. Combined
# with `acks=all` this delivers exactly-once produce semantics within
# a single producer session — critical for `product.*` events because
# duplicate publications would cause Recommendation Engine to overweight
# popularity scores.
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# Wire compression applied to record batches before transmission.
# `lz4` offers the best CPU/throughput trade-off for catalog payloads
# (mostly text fields). Allowed values: none | gzip | snappy | lz4 | zstd.
KAFKA_PRODUCER_COMPRESSION_TYPE=lz4

# Maximum time (ms) the producer will wait while accumulating records
# into a single batch before sending. A small linger window provides
# meaningful batching efficiency without adding noticeable end-user
# latency on admin writes.
KAFKA_PRODUCER_LINGER_MS=10

# Maximum size (bytes) of a single batch sent to a partition. 32 KiB
# comfortably fits a few dozen `product.*` events; larger batches
# improve throughput at the cost of per-record latency.
KAFKA_PRODUCER_BATCH_SIZE=32768

# Per-request timeout (ms) for a single produce call to a broker.
# After this timeout the producer either retries internally (within
# the delivery timeout below) or surfaces an error to the application.
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=30000

# Total budget (ms) per produce attempt chain — initial send plus all
# internal retries. Bounds the worst-case latency the application sees
# from `producer.send()` and aligns with AAP R-15 (bounded retry
# attempts). Beyond this the application MUST publish to the DLQ
# topic for the failed event.
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000

# Suffix appended to a base topic to form its retry topic per AAP R-17,
# e.g. `product.created` -> `product.created.retry`. Failed publications
# are republished here with backoff metadata before final DLQ routing.
KAFKA_RETRY_TOPIC_SUFFIX=.retry

# Suffix appended to a base topic to form its dead-letter topic per
# AAP R-17, e.g. `product.created` -> `product.created.dlq`. Events
# that exhaust all retries are persisted here for human triage.
KAFKA_DLQ_TOPIC_SUFFIX=.dlq

# -----------------------------------------------------------------------------
# Topics produced (see config/default.yaml for the authoritative list):
#   - product.created
#   - product.updated
#
# DLQ topics produced to (on persistent failure / schema validation failure):
#   - product.created.dlq
#   - product.updated.dlq
#
# Topics consumed: NONE (this service is a pure event producer).
#
# Partition key for all `product.*` events: product_id (ensures per-product
# strict ordering for consumers — AAP R-30 implication: a `product.updated`
# must never be observed before its corresponding `product.created`).
# -----------------------------------------------------------------------------


# =============================================================================
# Group D: Catalog Domain Configuration
# =============================================================================
# Domain-specific knobs governing how the catalog API serves listing,
# searching, and slug allocation. Defaults are tuned for a typical
# e-commerce browsing pattern (small page size, sorted by recency)
# and can be overridden per environment without code changes.

# Default page size for `GET /products` and `GET /categories` when the
# caller does not specify `?page_size=`. Small enough to keep response
# bodies snappy on mobile clients, large enough to amortize round-trips.
CATALOG_DEFAULT_PAGE_SIZE=20

# Hard cap on `?page_size=` accepted by listing endpoints. Requests that
# specify a larger page size receive `400 Bad Request`. Prevents
# expensive `COLLSCAN`-equivalent scans from misconfigured admin tools.
CATALOG_MAX_PAGE_SIZE=100

# Default sort order applied when the caller does not specify `?sort=`.
# Format: `<field>:<direction>` (direction in {asc, desc}). `created_at:desc`
# surfaces newly added products first — the right default for catalog
# discovery. Admin tooling typically overrides this with `updated_at:desc`.
CATALOG_DEFAULT_SORT=created_at:desc

# Comma-separated list of slug prefixes that may not be used for a
# product or category slug because they collide with reserved API or
# operational paths. Validation rejects any slug that begins with one
# of these prefixes (`/products/admin` would never resolve to a product).
CATALOG_SLUG_RESERVED_PREFIXES=admin,api,health,metrics

# How many days a soft-deleted product remains queryable for admins
# (and addressable by old links) before it is purged by the periodic
# cleanup job. 30 days gives ops a comfortable forensic window without
# bloating the active collection.
CATALOG_SOFT_DELETE_GRACE_DAYS=30

# Default language used by the MongoDB text index when a query specifies
# no `$language`. English is the platform default; localized catalogs
# override this per deployment (e.g., `german`, `french`, `italian`).
# See https://www.mongodb.com/docs/manual/reference/text-search-languages/
# for the supported list.
CATALOG_TEXT_SEARCH_LANGUAGE=english


# =============================================================================
# Group E: Idempotency (Admin Writes)
# =============================================================================
# Admin writes (`POST /products`, `PUT /products/{id}`, `DELETE
# /products/{id}`, category mutations) accept an `Idempotency-Key`
# header so a client can retry a failed call safely without producing
# duplicate `product.created` events. The key + a hash of the request
# body is persisted briefly; a second request bearing the same key with
# a matching hash returns the original response, while a mismatched
# hash returns `409 Conflict`.

# Inbound HTTP header name carrying the idempotency key. Standard
# spelling per IETF draft `draft-ietf-httpapi-idempotency-key-header`.
IDEMPOTENCY_KEY_HEADER=Idempotency-Key

# How long (hours) the service remembers an idempotency key + response
# pair. 24h comfortably exceeds any human-driven admin retry window
# while keeping the idempotency collection small. Admin writes are
# infrequent so longer TTLs are unnecessary.
IDEMPOTENCY_KEY_TTL_HOURS=24

# Algorithm used to hash the request body for replay-mismatch detection.
# `sha256` is collision-resistant for any plausible request size; never
# use `md5` or `sha1` here. Allowed values: sha256 | sha512.
IDEMPOTENCY_REQUEST_HASH_ALGO=sha256



# =============================================================================
# Group F: HTTP Client Resilience — AAP R-15, R-16
# =============================================================================
# Default values applied to every outbound HTTP call this service makes.
# Outbound HTTP traffic is intentionally minimal — primarily JWKS fetches
# from the Auth Service for JWT validation (Group G). The variables in
# this group keep retry / circuit-breaker behavior consistent with the
# sibling services (notification-service, payment-service) so operators
# learn ONE resilience playbook for the whole monorepo.

# TCP / TLS handshake timeout (ms) for outbound HTTP calls without a
# more specific override. Tight enough to fail fast against an
# unreachable host without flapping the circuit breaker on transient
# packet loss.
HTTP_DEFAULT_CONNECT_TIMEOUT_MS=2000

# Response read timeout (ms) for outbound HTTP calls without a more
# specific override. Bounds the overall call latency for JWKS fetches
# and any future external integrations.
HTTP_DEFAULT_READ_TIMEOUT_MS=5000

# `User-Agent` header sent on every outbound HTTP request. Aids upstream
# providers in identifying our traffic during incident triage and rate
# limit allocation.
HTTP_USER_AGENT=product-service/1.0

# Maximum number of attempts (initial + retries) per AAP R-15. After
# this is exhausted the call surfaces an error to the caller and the
# circuit-breaker counters tick toward OPEN.
HTTP_RETRY_MAX_ATTEMPTS=3

# Initial backoff (ms) before the first retry. Combined with
# HTTP_RETRY_MULTIPLIER and HTTP_RETRY_JITTER_PCT to compute the
# effective sleep on each attempt per AAP R-15.
HTTP_RETRY_INITIAL_DELAY_MS=200

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15). 2.0 doubles the sleep each round
# (200 ms -> 400 ms -> 800 ms -> ...).
HTTP_RETRY_MULTIPLIER=2.0

# Cap (ms) on the per-attempt backoff so the worker never sleeps for an
# unbounded duration even if the multiplier compounds over many retries.
HTTP_RETRY_MAX_DELAY_MS=5000

# Jitter percentage added to each backoff value (uniform random in
# `[-jitter, +jitter]` * delay) to avoid thundering-herd retries across
# many workers (AAP R-15). 0.2 means +/-20% of the computed backoff.
HTTP_RETRY_JITTER_PCT=0.2

# Failure-rate threshold (percent) at which the HTTP circuit breaker
# transitions from CLOSED to OPEN per AAP R-16. Computed over the
# rolling window after HTTP_CB_CALL_VOLUME_THRESHOLD calls have been
# observed.
HTTP_CB_FAILURE_RATE_THRESHOLD=50

# Minimum number of calls in the rolling window before the circuit
# breaker can compute a meaningful failure rate. Below this volume
# the breaker remains CLOSED regardless of failure ratio to avoid
# tripping on a single early failure.
HTTP_CB_CALL_VOLUME_THRESHOLD=20

# Duration (ms) the circuit breaker remains OPEN before transitioning
# to HALF_OPEN to probe the upstream provider per AAP R-16.
HTTP_CB_OPEN_DURATION_MS=30000

# Number of probe calls permitted while the circuit breaker is in the
# HALF_OPEN state before deciding CLOSED vs OPEN per AAP R-16.
HTTP_CB_HALF_OPEN_PERMITTED_CALLS=1


# =============================================================================
# Group G: Authentication / JWT Validation — AAP R-21, R-22, R-23
# =============================================================================
# The Product Service VALIDATES JWTs minted by the Auth Service. It is
# NEVER an issuer (per AAP R-21 — Auth Service is the sole issuer of JWT
# tokens). Public keys are fetched from the Auth Service JWKS endpoint
# and cached with a bounded TTL (per AAP R-22). Per-endpoint scope
# requirements enforce least-privilege access — anonymous reads are
# permitted on the public catalog browse endpoints; admin writes require
# the `products:admin` scope.

# Base URL of the Auth Service. EMPTY in this template; populated per
# environment via Vault / K8s ConfigMap. Used as the `${AUTH_SERVICE_URL}`
# substitution inside JWT_PUBLIC_KEY_URL when not supplied directly.
AUTH_SERVICE_URL=

# Full URL of the JWKS endpoint exposed by the Auth Service, e.g.
#   https://auth.example.com/.well-known/jwks.json
# EMPTY in this template — populated per environment. The service
# fetches and caches the JWK set on startup and refreshes it according
# to JWT_JWKS_CACHE_TTL_SECONDS.
JWT_PUBLIC_KEY_URL=

# Bounded TTL (seconds) for cached JWKS responses (AAP R-22). Aggressive
# caching reduces auth-service load; bounded TTL ensures key rotation
# propagates without service restart.
JWT_JWKS_CACHE_TTL_SECONDS=3600

# Expected `iss` (issuer) claim on every accepted JWT. EMPTY in this
# template; in production this is the canonical Auth Service issuer URL.
# Tokens with a mismatched `iss` are rejected with `401 Unauthorized`.
JWT_ISSUER=

# Expected `aud` (audience) claim on every accepted JWT. The Auth
# Service mints tokens with `aud=product-service` for any caller
# attempting to invoke this service's API. Tokens addressed to a
# different audience are rejected with `401 Unauthorized`.
JWT_AUDIENCE=product-service

# Comma-separated list of allowed signature algorithms. Asymmetric
# algorithms only (per AAP R-23: OAuth 2.0 with public-key signatures);
# symmetric algorithms (HS256/384/512) are FORBIDDEN here because they
# would imply this service shares a signing secret with the Auth
# Service — a violation of R-21.
JWT_ALGORITHMS=RS256,ES256

# OAuth scope required to invoke admin write endpoints (`POST /products`,
# `PUT /products/{id}`, `DELETE /products/{id}`, category mutations).
# Public read endpoints (`GET /products`, `GET /categories`) are
# accessible without this scope. Follows the `<resource>:<action>`
# scope-naming convention used across the monorepo.
JWT_REQUIRED_SCOPE_ADMIN=products:admin

# Clock-skew tolerance (seconds) on `exp` and `nbf` claim validation.
# Permits JWTs to remain valid for a brief window past their declared
# expiry, accommodating modest clock drift between the Auth Service
# host and this service's host without rejecting otherwise-valid
# tokens.
JWT_LEEWAY_SECONDS=30


# =============================================================================
# Group H: Observability — AAP R-13, R-26, R-27
# =============================================================================
# All structured JSON logs (AAP R-26) ship via Filebeat to Logstash
# (AAP R-27). Metrics expose on a separate port for Prometheus /
# Metricbeat scraping. OpenTelemetry traces are optional locally but
# mandatory in non-local environments. The correlation ID generated at
# the API Gateway is propagated through every HTTP call and Kafka
# message header (AAP R-13) for distributed tracing.

# Inbound / outbound HTTP header name used to propagate the request
# correlation ID across HTTP calls and Kafka message headers per
# AAP R-13. The API Gateway injects this header on every inbound
# request; this service preserves it on every log line and outbound
# call.
CORRELATION_ID_HEADER=X-Correlation-ID

# OpenTelemetry collector OTLP endpoint, e.g. http://otel-collector:4317
# Optional in local development; required in dev / stage / prod.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logical service name attached to every emitted span. Must match
# SERVICE_NAME for cross-correlation between logs and traces in Kibana
# / Jaeger.
OTEL_SERVICE_NAME=product-service

# Sampling strategy for OpenTelemetry traces. `parentbased_always_on`
# samples 100% of traces when no parent context is provided and respects
# upstream sampling decisions when a parent context is present.
# Override to `parentbased_traceidratio` with a ratio in non-local
# environments to control trace volume.
OTEL_TRACES_SAMPLER=parentbased_always_on

# HTTP port exposing the Prometheus metrics endpoint. Scraped by
# Metricbeat (per AAP R-27) and forwarded into Elasticsearch indices.
# Distinct from SERVICE_PORT so application traffic and metrics traffic
# can be segregated by network policy.
METRICS_PORT=9090

# URL path served by the Prometheus metrics endpoint on METRICS_PORT.
# Standard `/metrics` per Prometheus conventions; override only when a
# reverse proxy mounts the metrics under a non-standard prefix.
METRICS_PATH=/metrics


# =============================================================================
# Group I: Feature Flags
# =============================================================================
# Domain-specific behavior toggles. Stable features default to `true`;
# experimental or expensive features default to `false` so they are
# explicitly enabled per environment after validation. Cache sizing
# parameters are co-located with their corresponding feature flag for
# easier review.

# Master switch for MongoDB text-index search on `GET /products?q=`.
# Requires the corresponding text index to exist in MongoDB (created by
# the migration scripts under `services/product-service/migrations/`).
# Disable only when the text index has been dropped for maintenance.
FEATURE_TEXT_SEARCH_ENABLED=true

# Master switch for aggregation-pipeline faceted search (counts per
# brand / category / price-range alongside the result page). More
# expensive than a simple text search because it adds a `$facet` stage
# — disabled by default so it is opt-in per deployment after capacity
# planning.
FEATURE_FACETED_SEARCH_ENABLED=false

# Master switch for the in-process LRU cache that serves
# `GET /categories` (the full category tree) without a database round
# trip. Highly effective because the category tree changes rarely and
# is read on nearly every catalog page render.
FEATURE_CATEGORY_TREE_CACHE_ENABLED=true

# TTL (seconds) before a cached category tree entry is reloaded from
# MongoDB. 5 minutes balances freshness against cache hit rate;
# admin tools that mutate the tree should call the explicit
# `POST /admin/categories/cache/invalidate` endpoint to bypass TTL.
CATEGORY_TREE_CACHE_TTL_SECONDS=300

# Maximum number of category-tree variants retained in the LRU cache.
# Sized to comfortably hold every locale variant of the tree plus a
# handful of admin-only views.
CATEGORY_TREE_CACHE_MAX_SIZE=1024


# =============================================================================
# IMPORTANT:
#   * Never commit real values for MONGODB_URL, SCHEMA_REGISTRY_AUTH, or
#     any *_URL pointing at production. Use Kubernetes Secrets / Vault.
#   * JWT keys are fetched at runtime from JWT_PUBLIC_KEY_URL; no static
#     signing secret is required here (this service only VALIDATES JWTs —
#     AAP R-21: Auth Service is the sole issuer).
#   * In Kubernetes, these values come from a ConfigMap (non-secret) plus
#     a Secret (credentials) pair; in production prefer IAM role
#     assumption / workload identity over long-lived static credentials.
#   * MongoDB is the chosen store for THIS service per AAP R-7 (flexible
#     schema for varied product attributes); other Python services in
#     this monorepo use PostgreSQL — DO NOT copy this file's database
#     group (Group B) to those services.
#   * This service is a PURE EVENT PRODUCER (no `KAFKA_GROUP_ID`,
#     `KAFKA_AUTO_OFFSET_RESET`, or other consumer variables appear
#     here by design). Sibling services that consume events declare
#     those variables themselves.
#   * The authoritative non-secret configuration file for this service
#     is `services/product-service/config/default.yaml` (per AAP R-25).
#     Anything that is not a secret SHOULD live there; this `.env`
#     file is reserved for secrets and per-environment overrides.
# =============================================================================

