{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
      "format": "%(asctime)s %(levelname)s %(name)s %(correlation_id)s %(user_id)s %(route)s %(method)s %(status)s %(latency_ms)s %(message)s",
      "rename_fields": {
        "levelname": "level",
        "asctime": "timestamp",
        "name": "service"
      },
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "product_service": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "motor": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    },
    "pymongo": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    },
    "confluent_kafka": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    },
    "urllib3": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["stdout"],
    "level": "INFO"
  }
}
