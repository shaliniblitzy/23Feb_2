# =============================================================================
# Order Service — Environment Variable Template
# =============================================================================
# Saga Coordinator for the e-commerce checkout flow.
# Coordinates: Order ↔ Inventory ↔ Payment ↔ Notification via Kafka events.
#
# This file is a TEMPLATE. Copy it to `.env` for local development and populate
# real values out-of-band. `.env` is git-ignored.
#
# In non-local environments (dev / stage / prod) every value below is injected
# from a Kubernetes Secret + ConfigMap pair, HashiCorp Vault, or the equivalent
# cloud-provider secret manager. NEVER commit real values to source control.
#
# Per AAP R-25 (CRITICAL SECURITY RULE):
#   "Secrets must never appear in source or configuration files. Use Kubernetes
#    Secrets, Vault, or cloud provider secret managers; `.env.example` files
#    contain only variable names, never values."
#
# Per AAP R-18 (SAGA PATTERN — Order Service is the saga coordinator):
#   "The Order Service must implement the saga pattern with explicit
#    compensation steps for inventory release and payment reversal on failure."
#
# Per AAP R-19 (FAIL FAST):
#   "Every service must expose a liveness and readiness probe (`/health/live`,
#    `/health/ready`) and must fail fast on missing critical dependencies at
#    startup."
#
# Conventions followed in this file:
#   * Variable names use SCREAMING_SNAKE_CASE exclusively.
#   * Sensitive variables (database URLs, JWKS endpoints pointing at a
#     production issuer, Schema Registry credentials) are EMPTY (`NAME=`)
#     in this template.
#   * Non-secret defaults (timeouts, retry counts, ports, TTLs, log level,
#     booleans) carry sane example values so a developer can
#     `cp .env.example .env` and start the service against local dependencies.
#   * Each group is preceded by a `# === Group X: Title ===` banner.
#   * Variables within a group are sorted by frequency-of-change: the most
#     commonly overridden variables appear first; defaults appear last.
#   * Each variable carries an inline `# comment` describing its purpose,
#     units (ms, seconds, count), and any acceptable values.
#
# The authoritative configuration file for this service is
# `services/order-service/config/default.yaml`. Values here override or supply
# secrets that must NOT live in `default.yaml` (per AAP R-25).
# =============================================================================


# =============================================================================
# Group A: Service Runtime
# =============================================================================
# Identity, listen port, environment classification, and log shape for the
# Order Service process. These values are propagated into every log line
# and metric tag (per AAP R-26 — structured JSON logs include `service`).

# Logical service name embedded in every log line and metric tag (AAP R-26).
# MUST match the folder name `services/order-service/` exactly.
SERVICE_NAME=order-service

# HTTP listen port for the public API (POST /orders, GET /orders/{id},
# admin operations) and management endpoints (`/health/live`,
# `/health/ready`, `/metrics`). Must match the Dockerfile EXPOSE
# directive and the container's livenessProbe / readinessProbe httpGet
# port (AAP R-19).
SERVICE_PORT=8000

# Logical environment classifier — emitted as a tag on every log/metric.
# Allowed values: local | dev | staging | prod
ENVIRONMENT=local

# Log verbosity. Allowed values: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Log shape. Per AAP R-26 the platform standard is structured JSON with
# fields: timestamp, level, service, correlation_id, user_id, route,
# method, status, latency_ms, message. `json` is mandatory in non-local
# environments; `text` is permitted only for local debugging.
LOG_FORMAT=json


# =============================================================================
# Group B: Database — PostgreSQL `order_db` (private to Order Service per AAP R-6)
# =============================================================================
# The Order Service owns its private `order_db` PostgreSQL instance per
# AAP R-6 (database-per-service). Schema includes the four tables defined
# in AAP Section 0.4.4: `orders`, `order_items`, `order_status_history`,
# and `saga_state`. The `saga_state` table is the durable backing store
# for the saga coordinator's state machine (AAP R-18). No other service
# may read or write this database directly — all cross-service access
# happens via REST through the Order Service API or via Kafka events.

# Full libpq connection URL — e.g.
#   postgresql://order_user:<password>@order-db:5432/order_db
# EMPTY in this template; the real value is supplied by Vault / K8s Secret.
POSTGRES_URL=

# Minimum idle connections kept warm in the pool. Tuned to avoid cold-start
# latency for the first POST /orders after a quiet period.
POSTGRES_POOL_MIN=2

# Maximum total connections the pool will open. Sized to comfortably absorb
# burst traffic during checkout peaks (each saga step performs at least
# one transactional `saga_state` update) while staying well below the
# database server's `max_connections` to leave headroom for migrations
# and admin tools.
POSTGRES_POOL_MAX=20

# Per-statement server-side timeout (ms). Enforced via `SET statement_timeout`
# on connection checkout to bound worst-case query latency. CRITICAL for
# the saga coordinator: a slow query must not stall the entire checkout
# pipeline. Failing fast surfaces the issue to circuit breakers and the
# saga scheduler so compensation can run without delay.
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# TCP / TLS handshake timeout when establishing a new connection.
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# TLS posture for connections to PostgreSQL. Allowed values:
#   prefer       — opportunistic TLS (acceptable on Compose loopback only)
#   require      — TLS mandatory; certificate not verified
#   verify-ca    — TLS mandatory; verify CA chain
#   verify-full  — TLS mandatory; verify CA + hostname (REQUIRED in prod
#                  per AAP R-24 — all inter-service traffic must be TLS).
POSTGRES_SSLMODE=prefer


# =============================================================================
# Group C: Apache Kafka — AAP R-14, R-17, R-30, R-32
# =============================================================================
# The Order Service is BOTH producer and consumer:
#   * Produces: order.created, order.cancelled, order.fulfilled
#     (mission-critical saga events — strongest delivery guarantees apply).
#   * Consumes: inventory.reserved, inventory.reservation_failed,
#     payment.succeeded, payment.failed
#     (saga step replies driving forward progression / compensation).
# All produced events carry a schema version (AAP R-31) and are validated
# against Schema Registry on the producer side (AAP R-14). All consumed
# events are validated against Schema Registry on the consumer side too.

# Comma-separated broker list, e.g. kafka-1:9092,kafka-2:9092,kafka-3:9092.
# EMPTY in this template; populated by Vault / K8s ConfigMap.
KAFKA_BOOTSTRAP=

# Consumer group identifier. Sharing a single group across all replicas
# spreads partitions evenly and ensures at-least-once delivery semantics.
# WARNING: do NOT change this value after the first deploy — renaming the
# consumer group would silently re-consume the entire retained history of
# every subscribed topic and could cause duplicate saga side-effects.
KAFKA_GROUP_ID=order-service

# Confluent Schema Registry URL used to validate every event payload
# (AAP R-14). EMPTY in this template; populated by Vault / K8s ConfigMap.
SCHEMA_REGISTRY_URL=

# Optional Schema Registry HTTP Basic Auth credentials. Leave EMPTY when
# Schema Registry is unauthenticated (local Compose) or when mTLS is the
# active auth scheme. In production these are loaded from a K8s Secret.
SCHEMA_REGISTRY_AUTH_USER=
SCHEMA_REGISTRY_AUTH_PASS=

# -----------------------------------------------------------------------------
# Consumer tuning
# -----------------------------------------------------------------------------

# Where to start consuming when no committed offset exists for the group.
# Allowed values: earliest | latest | none.
# `earliest` ensures a freshly deployed Order Service picks up any in-flight
# saga replies that were produced while it was down — required for crash
# recovery semantics.
KAFKA_AUTO_OFFSET_RESET=earliest

# Disable broker-side auto-commit so the consumer commits offsets ONLY
# AFTER the corresponding `saga_state` row update has durably persisted.
# CRITICAL for saga correctness (AAP R-18) — auto-commit could lose state
# transitions if the service crashes between processing an event and
# writing `saga_state`. Manual commit AFTER durable saga_state write is
# the only correct semantic for the saga coordinator.
KAFKA_ENABLE_AUTO_COMMIT=false

# Maximum records returned in a single poll() — bounds peak memory and the
# blast radius of a poison message before the consumer rebalances.
KAFKA_CONSUMER_MAX_POLL_RECORDS=50

# Time the broker waits for a heartbeat before declaring the consumer dead
# and triggering a rebalance.
KAFKA_SESSION_TIMEOUT_MS=30000

# Heartbeat interval the consumer sends to the group coordinator. Must be
# significantly less than KAFKA_SESSION_TIMEOUT_MS.
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# Producer tuning — saga events are mission-critical, so the strongest
# durability guarantees apply (AAP R-32: producers must not know consumers
# but published events must reach EVERY interested consumer reliably).
# -----------------------------------------------------------------------------

# Producer acknowledgement mode. `all` waits for the in-sync replica set
# to acknowledge each record — the strongest durability guarantee.
# Mandatory for saga lifecycle events where data loss would silently
# wedge order state.
KAFKA_PRODUCER_ACKS=all

# Enable Kafka producer idempotence so a retried produce after broker ack
# loss does not result in duplicate event publication. Combined with
# `acks=all` this delivers exactly-once produce semantics within a
# producer session — essential for the saga's commit/compensation events.
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# Producer batching window (ms). Small values reduce end-to-end latency
# for saga progression at the cost of slightly lower throughput. The
# saga coordinator's events are low-volume + latency-sensitive, so a
# small linger is appropriate.
KAFKA_PRODUCER_LINGER_MS=10

# Compression codec for produced records. `zstd` provides the best
# ratio-to-CPU trade-off for JSON / Avro payloads.
# Allowed values: none | gzip | snappy | lz4 | zstd
KAFKA_PRODUCER_COMPRESSION_TYPE=zstd

# -----------------------------------------------------------------------------
# Retry & DLQ topology (AAP R-17). Suffixes are appended to the consumed
# base topic name to form the retry / DLQ partner topics, e.g.
# `inventory.reserved` -> `inventory.reserved.retry` -> `inventory.reserved.dlq`.
# -----------------------------------------------------------------------------

# Suffix appended to a base topic to form its retry topic per AAP R-17.
# Failed messages are republished here with backoff metadata before final
# DLQ routing.
KAFKA_RETRY_TOPIC_SUFFIX=.retry

# Suffix appended to a base topic to form its dead-letter topic per AAP R-17.
# Messages exhausting all retries are persisted here for human triage.
KAFKA_DLQ_TOPIC_SUFFIX=.dlq

# Maximum in-process retry attempts for a single message before it is
# routed to the retry topic. Aligns with AAP R-15 (bounded retry count).
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3

# Initial backoff (ms) between in-process retries. Multiplied with an
# exponential factor + jitter on each subsequent attempt.
KAFKA_CONSUMER_RETRY_BACKOFF_MS=500

# -----------------------------------------------------------------------------
# Topic names produced by Order Service (AAP R-30: <domain>.<verb>).
# These are environment-overridable so operators can run multiple
# logical platforms on a shared Kafka cluster (e.g. via topic prefixes).
# -----------------------------------------------------------------------------

# Emitted when a new order has been validated and persisted to `orders`
# with status=PENDING. Kicks off the saga (consumed by Inventory Service
# for stock reservation and by Notification Service for confirmation).
TOPIC_ORDER_CREATED=order.created

# Emitted when an order transitions to status=CANCELLED — either by
# explicit user action, saga compensation (inventory or payment failure),
# or the saga compensation timeout (Group E).
TOPIC_ORDER_CANCELLED=order.cancelled

# Emitted when an order reaches the terminal status=FULFILLED — payment
# captured, inventory committed, notifications dispatched.
TOPIC_ORDER_FULFILLED=order.fulfilled

# -----------------------------------------------------------------------------
# Topic names consumed by Order Service (saga step replies).
# -----------------------------------------------------------------------------

# Inventory has reserved stock for the saga's order. Drives the saga
# forward to the payment step.
TOPIC_INVENTORY_RESERVED=inventory.reserved

# Inventory could not reserve stock (out-of-stock, oversold race, etc.).
# Triggers saga compensation (no payment is taken; order is cancelled).
TOPIC_INVENTORY_RESERVATION_FAILED=inventory.reservation_failed

# Payment has been captured successfully. Drives the saga to the
# terminal FULFILLED state and emits `order.fulfilled`.
TOPIC_PAYMENT_SUCCEEDED=payment.succeeded

# Payment failed. Triggers saga compensation: release the inventory
# reservation, mark the order CANCELLED, emit `order.cancelled`.
TOPIC_PAYMENT_FAILED=payment.failed

# Internal poison-message DLQ for events that cannot be parsed at all
# (schema deserialization failure, missing required headers, etc.).
# Aligns with AAP Section 0.4.2 + AAP R-17.
TOPIC_ORDER_DLQ=order.dlq


# =============================================================================
# Group D: Authentication / JWT Validation — AAP R-21, R-22, R-23
# =============================================================================
# The Order Service VALIDATES JWTs minted by the Auth Service. It is NEVER
# an issuer (per AAP R-21 — the Auth Service is the SOLE issuer of JWT
# tokens). Public keys are fetched from the Auth Service JWKS endpoint
# and cached with a bounded TTL (per AAP R-22) so rotation propagates
# without service restart.

# Base URL of the Auth Service. EMPTY in this template; populated per
# environment via Vault / K8s ConfigMap. e.g. http://auth-service:8000
# in Docker Compose, https://auth.example.com in production.
AUTH_SERVICE_URL=

# Full URL of the JWKS endpoint exposed by the Auth Service, e.g.
#   {AUTH_SERVICE_URL}/.well-known/jwks.json
# EMPTY in this template — populated per environment.
JWT_PUBLIC_KEY_URL=

# Bounded TTL (seconds) for cached JWKS responses (AAP R-22). Aggressive
# caching reduces auth-service load; bounded TTL ensures key rotation
# propagates without service restart. Default 1 hour.
JWT_JWKS_CACHE_TTL_SECONDS=3600

# Expected `iss` (issuer) claim on every accepted JWT. EMPTY in this
# template; in production this is the canonical Auth Service issuer URL.
# MUST match the Auth Service's configured issuer exactly.
JWT_ISSUER=

# Expected `aud` (audience) claim on every accepted JWT. The Auth Service
# mints tokens with `aud=order-service` for any caller attempting to
# invoke this service's API. Tokens with a different audience are
# rejected even if the signature validates.
JWT_AUDIENCE=order-service

# Allowed clock-skew tolerance (seconds) when validating `exp` and `nbf`
# claims. Bounded to defeat trivial replay-after-expiry attacks while
# absorbing routine clock drift between hosts.
JWT_LEEWAY_SECONDS=10


# =============================================================================
# Group E: Saga Configuration — AAP R-18 (UNIQUE TO ORDER SERVICE)
# =============================================================================
# The Order Service is the platform's saga coordinator (AAP R-18). It owns
# the `saga_state` table in `order_db` and drives the checkout flow:
#
#     order.created
#         -> inventory reservation request
#             -> inventory.reserved   ──┐
#                                       │ (forward path)
#         -> payment authorization      │
#             -> payment.succeeded   ───┘
#                 -> order.fulfilled (terminal SUCCESS)
#
#     If any forward step fails or times out, the saga runs compensation:
#
#     inventory.reservation_failed
#         -> mark order CANCELLED, emit order.cancelled (no payment taken)
#
#     payment.failed
#         -> release inventory reservation
#         -> mark order CANCELLED, emit order.cancelled
#
# Every parameter below directly tunes the compensation engine described
# in `docs/architecture/resilience-patterns.md`. These values are the
# SERVICE-LEVEL DEFAULTS that operators tune per environment.

# Per-step deadline (ms). If the saga does not advance to the next step
# within this window (e.g. no `inventory.reserved` reply received within
# SAGA_STEP_TIMEOUT_MS of producing `order.created`), the scheduler
# triggers compensation (release inventory, refund payment if applicable).
# Sized to cover normal Kafka round-trip + downstream processing under
# load while still tripping fast enough that customers do not wait long
# for a definitive answer at checkout.
SAGA_STEP_TIMEOUT_MS=10000

# Total compensation deadline (ms). The saga MUST reach a terminal state
# (FULFILLED or CANCELLED) within this window from the time `order.created`
# was emitted. After this deadline the saga is marked FAILED and
# operators must investigate manually (alerted via Kibana). Acts as the
# overall sanity bound on a single checkout's lifetime.
SAGA_COMPENSATION_TIMEOUT_MS=30000

# Interval (ms) between scheduler poll cycles. The scheduler scans
# `saga_state` for stuck sagas (those past SAGA_STEP_TIMEOUT_MS without
# advancing) and drives timeout-based compensation. Lower values reduce
# detection latency for stuck sagas; higher values reduce database load.
SAGA_SCHEDULER_POLL_INTERVAL_MS=1000

# Maximum number of stuck sagas the scheduler picks up per poll cycle.
# Bounds the database working set and the burst rate of compensation
# Kafka messages produced per cycle.
SAGA_SCHEDULER_BATCH_SIZE=50

# Maximum number of compensation attempts before a saga is marked FAILED
# requiring manual intervention. Each compensation attempt re-emits the
# compensation events with idempotency guarantees. Exhausting this bound
# emits the `saga_manual_intervention_total` metric, alerting operators
# via the Kibana dashboard.
SAGA_MAX_COMPENSATION_ATTEMPTS=5

# Initial backoff (ms) between compensation attempts. Multiplied with an
# exponential factor + jitter (defined in `config/default.yaml`) for
# subsequent attempts.
SAGA_COMPENSATION_BACKOFF_MS=2000

# Saga state retention (hours). Keep terminal sagas (FULFILLED, CANCELLED,
# FAILED) in `saga_state` for this long for forensic analysis before
# archival. Does NOT delete the corresponding `orders` row (the order
# itself is retained per business retention policy); only the
# `saga_state` row is purged. Default 7 days = 168 hours.
SAGA_TERMINAL_RETENTION_HOURS=168


# =============================================================================
# Group F: Idempotency for Order Placement
# =============================================================================
# POST /orders is the most contended endpoint of the platform. The API
# Gateway may retry it on transient 5xx (per AAP R-15 retry semantics)
# and the client itself may retry on a browser refresh / network blip.
# Without idempotency these retries would create duplicate orders.
#
# The Order Service enforces idempotency via a client-supplied header
# (typically `Idempotency-Key`). The key is persisted alongside the
# request hash and the resulting order ID; replays return the original
# response without re-running the saga.

# HTTP header name through which clients (and the API Gateway) supply
# the idempotency key. Industry convention is `Idempotency-Key`
# (Stripe, Razorpay, IETF draft).
IDEMPOTENCY_KEY_HEADER=Idempotency-Key

# How long (hours) a client-provided idempotency key is remembered.
# Replays of the same key within this window return the original
# response. Sized longer than typical retry windows so a delayed retry
# from a flaky mobile network still hits the cached response. Default
# 72 hours = 3 days.
IDEMPOTENCY_KEY_TTL_HOURS=72

# Maximum length (characters) of a client-supplied idempotency key.
# Bounds the storage footprint and rejects malformed keys early at
# the API edge.
IDEMPOTENCY_KEY_MAX_LENGTH=128


# =============================================================================
# Group G: Outbound HTTP Client — AAP R-15 (Retries), R-16 (Circuit Breaker)
# =============================================================================
# The Order Service uses Kafka primarily for cross-service communication,
# but still makes outbound HTTP calls in a few places:
#   * JWKS fetch from the Auth Service to refresh signing keys.
#   * Optional read-side queries to Inventory / Payment services for
#     admin operations (e.g. order detail enrichment, saga forensics).
# Every outbound HTTP call MUST be wrapped with a retry policy
# (AAP R-15) AND a circuit breaker (AAP R-16). The defaults below apply
# to call sites that do not provide their own override.

# User-Agent header sent on every outbound HTTP request. Aids upstream
# operators in identifying our traffic during incident triage.
HTTP_USER_AGENT=order-service/1.0

# Default TCP / TLS handshake timeout (ms) for outbound HTTP calls
# without a more specific override.
HTTP_DEFAULT_CONNECT_TIMEOUT_MS=2000

# Default response read timeout (ms) for outbound HTTP calls without a
# more specific override.
HTTP_DEFAULT_READ_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Retry policy for idempotent outbound calls (AAP R-15)
# -----------------------------------------------------------------------------

# Maximum total attempts (initial + retries) for an idempotent HTTP
# request. Beyond this, the call fails fast and the circuit breaker is
# notified.
HTTP_RETRY_MAX_ATTEMPTS=3

# Initial backoff (ms) before the first retry. Combined with
# HTTP_RETRY_MULTIPLIER and HTTP_RETRY_JITTER to compute the effective
# sleep on each attempt.
HTTP_RETRY_INITIAL_BACKOFF_MS=200

# Cap (ms) on the per-attempt backoff so the worker never sleeps for an
# unbounded duration even if the multiplier compounds.
HTTP_RETRY_MAX_BACKOFF_MS=2000

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15).
HTTP_RETRY_MULTIPLIER=2.0

# Whether to apply uniform random jitter to each backoff to avoid
# thundering-herd retries across replicas. Allowed values: true | false.
HTTP_RETRY_JITTER=true

# -----------------------------------------------------------------------------
# Circuit breaker thresholds — applied per outbound dependency (AAP R-16)
# -----------------------------------------------------------------------------

# Number of failures within HTTP_CB_FAILURE_WINDOW_SECONDS required to
# trip the breaker into the OPEN state.
HTTP_CB_FAILURE_THRESHOLD=10

# Rolling window (seconds) over which failures are counted toward
# HTTP_CB_FAILURE_THRESHOLD.
HTTP_CB_FAILURE_WINDOW_SECONDS=30

# Duration (seconds) the breaker stays OPEN before transitioning to
# HALF_OPEN to probe the upstream dependency.
HTTP_CB_OPEN_DURATION_SECONDS=30

# Number of probe calls permitted while the circuit breaker is in the
# HALF_OPEN state before deciding CLOSED vs OPEN.
HTTP_CB_HALF_OPEN_PROBES=2


# =============================================================================
# Group H: Observability — AAP R-26 (Structured JSON), R-27 (Beats), R-28 (Kibana)
# =============================================================================
# All structured JSON logs (AAP R-26) ship via Filebeat to Logstash
# (AAP R-27). Metrics expose on a separate port for Prometheus /
# Metricbeat scraping. OpenTelemetry traces are optional locally but
# mandatory in non-local environments. Saga-related spans are always
# sampled to ensure full forensic coverage of compensation flows.

# OpenTelemetry collector OTLP endpoint, e.g. http://otel-collector:4318.
# Optional in local development; required in dev / stage / prod.
# EMPTY in this template — populated by Vault / K8s ConfigMap.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logical service name attached to every emitted span. Must match
# SERVICE_NAME for cross-correlation between logs and traces.
OTEL_SERVICE_NAME=order-service

# Resource attributes attached to every emitted telemetry signal.
# Comma-separated `key=value` pairs in W3C Resource format.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=ecommerce,service.version=1.0.0

# Sampling policy for OpenTelemetry traces. `parentbased_traceidratio`
# inherits the parent decision (e.g. from the API Gateway) and falls
# back to a fixed ratio for root spans. Allowed values follow the
# OpenTelemetry SDK sampler specification.
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampling ratio (0.0 – 1.0) applied to root spans by the
# `traceidratio` portion of the sampler. 10% sampling balances
# observability cost vs coverage; saga-related spans are ALWAYS sampled
# via a custom rule layered on top of this default.
OTEL_TRACES_SAMPLER_ARG=0.1

# HTTP port exposing the Prometheus metrics endpoint. Scraped by
# Metricbeat (per AAP R-27) and forwarded into Elasticsearch indices.
METRICS_PORT=9090

# HTTP path under which the Prometheus metrics endpoint is mounted.
METRICS_PATH=/metrics

# HTTP header name through which the API Gateway propagates the
# correlation ID for distributed tracing (per AAP R-13). The Order
# Service propagates this header on every outbound call (Kafka headers
# and HTTP headers alike) and includes it in every log line.
CORRELATION_ID_HEADER=X-Correlation-ID


# =============================================================================
# Group I: Health Probes — AAP R-19
# =============================================================================
# Liveness and readiness probes consumed by Kubernetes (or the local
# Compose health check). Liveness checks confirm the process is alive;
# readiness checks confirm the process is able to serve traffic
# (database reachable, Kafka consumer joined, Schema Registry resolvable).
# Per AAP R-19, missing critical dependencies at startup MUST cause the
# service to fail fast and never report ready.

# HTTP path for the liveness probe. Returns 200 OK while the process is
# alive; never depends on downstream dependencies.
HEALTH_LIVENESS_PATH=/health/live

# HTTP path for the readiness probe. Returns 200 OK only when:
#   * the Postgres pool can issue a write to `saga_state`,
#   * the Kafka consumer has joined the group and assigned partitions,
#   * the Schema Registry is reachable,
#   * the JWKS endpoint has at least one cached signing key.
HEALTH_READINESS_PATH=/health/ready

# Aggregate timeout (ms) for the readiness probe's downstream checks.
# Probes that exceed this budget return 503 Service Unavailable so
# Kubernetes removes the pod from rotation until it recovers.
HEALTH_READY_TIMEOUT_MS=2000


# =============================================================================
# Group J: Order Domain Limits (Defensive)
# =============================================================================
# Defensive bounds enforced at the API edge to reject pathological
# requests before they touch the database or the saga coordinator.
# These limits protect both the platform (from abuse / accidental DoS)
# and downstream services (Inventory's reservation engine, Payment's
# provider rate limits) from oversized orders.

# Maximum number of distinct line items allowed per order.
ORDER_MAX_ITEMS=200

# Maximum quantity allowed per single line item. Wholesale-grade orders
# exceeding this cap must use a dedicated B2B path, not the standard
# checkout API.
ORDER_MAX_QUANTITY_PER_ITEM=999

# Minimum total order amount in MINOR units (cents / paise / pence) of
# the order's currency. Default 1 — i.e. 1 cent / 1 paisa minimum.
# Rejects zero-value orders early.
ORDER_MIN_TOTAL_AMOUNT_MINOR_UNITS=1

# Maximum total order amount in MINOR units. Default 10,000,000 minor
# units = $100,000.00 / ₹1,00,000.00 cap. Orders above this require a
# manual approval workflow, not the standard checkout path.
ORDER_MAX_TOTAL_AMOUNT_MINOR_UNITS=10000000

# Comma-separated allow-list of ISO 4217 currency codes accepted for
# new orders. Routing of these currencies to Stripe vs Razorpay happens
# in the Payment Service per AAP R-10 (data-driven provider selection);
# the Order Service merely accepts or rejects the order based on this
# list before emitting `order.created`.
ORDER_SUPPORTED_CURRENCIES=USD,EUR,GBP,INR,AUD,CAD


# =============================================================================
# IMPORTANT (Order Service is the saga coordinator):
#   * Required at startup (service MUST fail fast per AAP R-19 if any
#     of these are missing or unreachable):
#       - POSTGRES_URL          (private order_db with `saga_state`)
#       - KAFKA_BOOTSTRAP       (event backbone)
#       - SCHEMA_REGISTRY_URL   (event schema validation)
#       - AUTH_SERVICE_URL      (JWT validation)
#       - JWT_PUBLIC_KEY_URL    (JWKS endpoint)
#       - JWT_ISSUER            (expected `iss` claim)
#
#   * NEVER commit real values for POSTGRES_URL, SCHEMA_REGISTRY_AUTH_PASS,
#     or any *_URL pointing at a production endpoint.
#
#   * KAFKA_ENABLE_AUTO_COMMIT MUST remain `false` — the saga coordinator
#     commits offsets only AFTER the corresponding `saga_state` row has
#     durably persisted. Auto-commit would silently lose state transitions
#     across crashes (AAP R-18 saga correctness).
#
#   * KAFKA_PRODUCER_ENABLE_IDEMPOTENCE MUST remain `true` AND
#     KAFKA_PRODUCER_ACKS MUST remain `all` — saga lifecycle events
#     (order.created / order.cancelled / order.fulfilled) must not be
#     silently lost during broker failover.
#
#   * The Order Service does NOT need Stripe / Razorpay / Twilio /
#     SendGrid credentials — those belong to Payment / Notification
#     services. Do NOT add provider-specific keys here.
#
#   * The Order Service does NOT need Redis or pgvector — those are
#     specific to the Recommendation Engine.
#
#   * JWT keys are fetched at runtime from JWT_PUBLIC_KEY_URL; no static
#     signing secret is required here (this service only VALIDATES JWTs,
#     never issues them — AAP R-21).
#
#   * In Kubernetes, these values come from a ConfigMap (non-secret) plus
#     a Secret (credentials) pair; rotate via the runbook documented in
#     `docs/runbook/order-service.md`.
# =============================================================================
