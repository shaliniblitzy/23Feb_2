# =============================================================================
# User Service — Environment Variable Template
# =============================================================================
# Non-secret environment variable template for the User Service.
#
# AAP R-25 (CRITICAL SECURITY RULE):
#   "Secrets must never appear in source or configuration files. Use Kubernetes
#    Secrets, Vault, or cloud provider secret managers; `.env.example` files
#    contain only variable names, never values."
#
# This file contains variable NAMES only. Empty values (KEY=) MUST be supplied
# at runtime via Kubernetes Secrets, HashiCorp Vault, or your cloud provider's
# secret manager. Pre-populated values are sensible defaults that may be
# overridden per environment.
#
# USAGE:
#   cp .env.example .env
#   # populate empty values from your dev secrets store, then:
#   docker compose up user-service
#
# Per AAP R-21 (JWT ISSUER UNIQUENESS):
#   "The Auth Service is the sole issuer of JWT tokens. No other service may
#    mint tokens; all other services only validate JWTs issued by Auth
#    Service." — this service therefore declares ONLY validation variables
#    (JWKS endpoint, expected `iss` / `aud` claims, scope requirements);
#    NO signing-key variable exists in this template.
#
# Per AAP R-30 (EVENT NAMING):
#   "Events are owned by the producing domain and are named <domain>.<verb>."
#   This service consumes `user.registered` (from Auth Service) and produces
#   `user.updated` and `user.deleted` events.
#
# Conventions followed in this file:
#   * Variable names use SCREAMING_SNAKE_CASE exclusively.
#   * Sensitive variables (database URLs, Kafka SASL credentials, Schema
#     Registry credentials, PII anonymization salt) are EMPTY (`NAME=`) in
#     this template and the comment block immediately above each such
#     variable explicitly identifies it as a secret. Empty values MUST be
#     supplied at runtime via Kubernetes Secrets, HashiCorp Vault, or
#     your cloud provider's secret manager.
#   * Non-secret defaults (timeouts, retry counts, ports, TTLs, log level,
#     booleans) carry sane example values so a developer can
#     `cp .env.example .env` and start the service against local dependencies.
#   * Each group is preceded by a `# === Group X: Title ===` banner.
#   * Each variable is preceded by a `# comment` block describing its
#     purpose, units (ms, seconds, count), and any acceptable values.
#
# The authoritative configuration file for this service is
# `services/user-service/config/default.yaml`. Values here override or supply
# secrets that must NOT live in `default.yaml` (per AAP R-25).
# =============================================================================


# =============================================================================
# Group A: Service Runtime
# =============================================================================
# Identity, listen port, environment classification, and log shape for the
# User Service process. These values are propagated into every log line
# and metric tag (per AAP R-26 — structured JSON logs include `service`).

# Logical service name embedded in every log line and metric tag (AAP R-26).
# MUST match the folder name `services/user-service/` exactly. Used by the
# API Gateway routing layer, by Filebeat for log enrichment, and by
# OpenTelemetry as the default `service.name` resource attribute.
SERVICE_NAME=user-service

# Logical environment classifier — emitted as a tag on every log/metric.
# Allowed values: local | dev | staging | prod
# Gates feature flags and tightens TLS verification (e.g., POSTGRES_SSLMODE
# may be relaxed to `prefer` only when ENVIRONMENT=local).
ENVIRONMENT=local

# Log verbosity. Allowed values: DEBUG | INFO | WARN | ERROR
# `DEBUG` is permitted only for local debugging; `INFO` is the default in
# all non-local environments.
LOG_LEVEL=INFO

# Log shape. Per AAP R-26 the platform standard is structured JSON with
# fields: timestamp, level, service, correlation_id, user_id, route,
# method, status, latency_ms, message. `json` is mandatory in non-local
# environments; `console` is permitted only for local debugging.
LOG_FORMAT=json

# HTTP bind address. `0.0.0.0` listens on every interface inside the
# container — required for Kubernetes service-port routing. Override to
# `127.0.0.1` only for ad-hoc local testing where external reachability
# is undesired.
HTTP_HOST=0.0.0.0

# HTTP listen port for the public API (`/users`, `/users/me`, addresses,
# preferences) and management endpoints (`/health/live`, `/health/ready`,
# `/metrics`). Must match the Dockerfile EXPOSE directive and the
# container's livenessProbe / readinessProbe httpGet port (AAP R-19).
HTTP_PORT=8000

# Uvicorn worker count — the number of worker processes spawned by the
# ASGI server. Matches the Dockerfile CMD default. Tune per pod CPU
# allocation: a 2-CPU pod typically runs 2 workers; a 4-CPU pod, 4.
HTTP_WORKERS=2

# Server-side wall-clock timeout per request (seconds). Bounds worst-case
# request latency seen by the API Gateway and prevents hung handlers from
# tying up worker slots indefinitely.
HTTP_REQUEST_TIMEOUT_SECONDS=30

# HTTP keep-alive timeout (seconds) for idle TCP connections. Tuned to
# match the API Gateway's idle-connection reaper so half-closed sockets
# do not accumulate.
HTTP_KEEPALIVE_SECONDS=5

# Comma-separated list of allowed origins for CORS preflight responses.
# Empty in non-local environments because the API Gateway terminates
# CORS for every public route. Local-only example: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Comma-separated CIDRs (e.g., the gateway's internal range) trusted for
# `X-Forwarded-For` parsing. Required when the service is fronted by a
# reverse proxy / API Gateway so the real client IP is correctly logged
# on every request. Empty in this template; populated per environment.
TRUSTED_PROXIES=


# =============================================================================
# Group B: Database — PostgreSQL `user_db` — AAP R-6, R-7, Section 0.4.4
# =============================================================================
# The User Service owns its private `user_db` PostgreSQL instance per
# AAP R-6 (database-per-service). Schema includes the four tables defined
# in AAP Section 0.4.4: `users`, `user_profiles`, `user_preferences`,
# and `user_addresses`. PostgreSQL was chosen per AAP R-7 because user
# data is relational (1:1 user↔profile, 1:N user↔address) and benefits
# from strong transactional guarantees on profile/preference updates.
# No other service may read or write this database directly — all
# cross-service access happens via this service's REST API or via Kafka
# events (AAP R-6).

# Full SQLAlchemy DSN — e.g.
#   postgresql+psycopg://user-service-app:<password>@user-db:5432/user_db?sslmode=verify-full
# EMPTY in this template per AAP R-25; the real value is supplied by
# Vault / K8s Secret. The `psycopg` driver suffix selects psycopg v3
# which is the canonical Python Postgres driver across the monorepo.
POSTGRES_URL=

# Minimum idle connections kept warm in the pool. Tuned to avoid
# cold-start latency for the first request after a quiet period.
POSTGRES_POOL_MIN_SIZE=2

# Maximum total connections the pool will open. Sized to comfortably
# absorb burst traffic on profile-update endpoints while staying well
# below the database server's `max_connections` to leave headroom for
# migrations and admin tools.
POSTGRES_POOL_MAX_SIZE=10

# Maximum time (seconds) a request will wait for a free pool connection
# before failing fast. Aligns with HTTP_REQUEST_TIMEOUT_SECONDS so the
# request fails on the application side before the upstream client
# times out.
POSTGRES_POOL_TIMEOUT_SECONDS=10

# Per-statement server-side timeout (ms). Enforced via `SET statement_timeout`
# on connection checkout to bound worst-case query latency. Slow queries
# above this budget are killed by Postgres rather than tying up the
# connection.
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# Per-transaction lock acquisition timeout (ms). Bounds how long a
# transaction will wait for a row-level lock on contended writes (e.g.,
# concurrent `UPDATE` on the same `users` row from a profile edit and
# a preference toggle). Failed lock acquisition surfaces as
# `LockNotAvailable` to the caller.
POSTGRES_LOCK_TIMEOUT_MS=2000

# Idle-in-transaction timeout (ms). Prevents abandoned transactions
# from holding row locks indefinitely after a client crash or network
# partition.
POSTGRES_IDLE_IN_TXN_TIMEOUT_MS=5000

# Postgres `application_name` propagated to the server for connection
# diagnostics (`pg_stat_activity.application_name`). Aids upstream
# operators in attributing connections to this service during incident
# triage.
POSTGRES_APPLICATION_NAME=user-service

# TLS verification mode. Allowed values: disable | allow | prefer |
# require | verify-ca | verify-full. Production default is `verify-full`
# (server cert validated against POSTGRES_SSL_ROOT_CERT and hostname
# matched). Relax to `prefer` only for local with ENVIRONMENT=local.
POSTGRES_SSLMODE=verify-full

# Path to a CA bundle (PEM) used to verify the Postgres server's TLS
# certificate when POSTGRES_SSLMODE=verify-ca or verify-full. Empty in
# this template; populated by the deployment to the in-cluster CA bundle
# location (e.g., `/etc/ssl/certs/private-ca.pem`).
POSTGRES_SSL_ROOT_CERT=


# =============================================================================
# Group C: Kafka Producer — AAP R-15, R-30, R-32
# =============================================================================
# The User Service is BOTH a Kafka producer and a Kafka consumer.
# As a producer it publishes `user.updated` and `user.deleted` domain
# events on every successful profile/account mutation. Idempotent
# producer (AAP R-32 implies producers must not know consumers but
# events must not be silently duplicated) plus `acks=all` deliver
# exactly-once produce semantics within a single producer session.
# Publication failures are routed to `<topic>.dlq` after exhausting
# the bounded delivery timeout per AAP R-15 / R-17.

# Comma-separated broker list — e.g.
#   kafka-1:9092,kafka-2:9092,kafka-3:9092
# Default points at the local Compose Kafka broker; override per
# environment via Vault / K8s ConfigMap.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Wire-protocol security mode for client-broker traffic. Allowed values:
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL. Local Compose uses
# PLAINTEXT; production MUST override to SASL_SSL per AAP R-24 (all
# inter-service traffic TLS-encrypted).
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL mechanism, populated when KAFKA_SECURITY_PROTOCOL is SASL_*.
# Recommended production value: `SCRAM-SHA-512`. Empty in this template;
# populated per environment.
KAFKA_SASL_MECHANISM=

# SASL username for broker authentication. Empty in this template;
# populated via K8s Secret / Vault per AAP R-25 (secret credentials
# never live in source control).
KAFKA_SASL_USERNAME=

# SASL password for broker authentication. Empty in this template;
# populated via K8s Secret / Vault per AAP R-25 (secret credentials
# never live in source control).
KAFKA_SASL_PASSWORD=

# Filesystem path to the CA bundle used to verify the Kafka broker's
# TLS certificate when KAFKA_SECURITY_PROTOCOL=SSL or SASL_SSL. Empty
# in this template; populated by the deployment.
KAFKA_SSL_CA_LOCATION=

# Producer `client.id` reported to the broker. Helps operators correlate
# producer-side metrics (records/sec, error rate, request latency) with
# this specific service when reviewing broker telemetry.
KAFKA_CLIENT_ID=user-service

# Producer acknowledgement mode. `all` waits for the in-sync replica set
# to acknowledge each record — the strongest durability guarantee.
# Mandatory per AAP R-15 (durable writes) for `user.*` events because
# downstream consumers (Notification Service, Recommendation Engine)
# treat these events as authoritative state changes.
KAFKA_PRODUCER_ACKS=all

# Enable Kafka producer idempotence so a retried produce after broker
# ack loss does not result in duplicate event publication. Combined
# with `acks=all` this delivers safe retry semantics — critical for
# `user.deleted` events because duplicate publications could trigger
# duplicate downstream cleanup work.
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# Wire compression applied to record batches before transmission.
# `zstd` offers the best CPU/throughput trade-off for JSON / Avro
# payloads. Allowed values: none | gzip | snappy | lz4 | zstd.
KAFKA_PRODUCER_COMPRESSION_TYPE=zstd

# Maximum time (ms) the producer will wait while accumulating records
# into a single batch before sending. A small linger window provides
# meaningful batching efficiency without adding noticeable end-user
# latency on profile-update writes.
KAFKA_PRODUCER_LINGER_MS=20

# Maximum size (bytes) of a single batch sent to a partition. 64 KiB
# comfortably fits a few dozen `user.*` events; larger batches improve
# throughput at the cost of per-record latency.
KAFKA_PRODUCER_BATCH_SIZE_BYTES=65536

# Per-request timeout (ms) for a single produce call to a broker.
# After this timeout the producer either retries internally (within
# the delivery timeout below) or surfaces an error to the application.
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=30000

# Total budget (ms) per produce attempt chain — initial send plus all
# internal retries. Bounds the worst-case latency the application sees
# from `producer.send()` and aligns with AAP R-15 (bounded retry
# attempts). Beyond this the application MUST publish to the DLQ
# topic for the failed event.
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000

# Maximum unacknowledged requests per broker connection. With
# idempotence enabled (above), values up to 5 are safe and preserve
# per-partition ordering.
KAFKA_PRODUCER_MAX_IN_FLIGHT_REQUESTS_PER_CONNECTION=5

# Producer-side internal retry count. The very large default relies on
# KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS to bound total time rather than
# attempt count — the canonical Kafka guidance for idempotent producers.
KAFKA_PRODUCER_RETRIES=2147483647

# Backoff (ms) between producer-side internal retries. Combined with
# producer-side jitter applied by librdkafka.
KAFKA_PRODUCER_RETRY_BACKOFF_MS=200


# =============================================================================
# Group D: Kafka Consumer — AAP R-15, R-17
# =============================================================================
# The User Service consumes `user.registered` events emitted by the Auth
# Service (Auth Service is the producer per AAP Section 0.4.2). On every
# `user.registered` the consumer creates the corresponding
# `users`/`user_profiles` rows so the user has an addressable identity in
# user_db. Manual offset commits (KAFKA_ENABLE_AUTO_COMMIT=false) ensure
# the consumer only acknowledges a message AFTER the durable Postgres
# write succeeds — failed processing is retried via the retry topology
# in Group E.

# Consumer group identifier. One consumer group per service per AAP
# convention; multiple replicas of this service share KAFKA_GROUP_ID
# and balance partitions among themselves via the group coordinator.
KAFKA_GROUP_ID=user-service

# Disable broker-side auto-commit so the consumer commits offsets ONLY
# AFTER the corresponding Postgres write has durably persisted.
# CRITICAL for at-least-once correctness — auto-commit could lose
# state transitions if the service crashes between processing an event
# and writing to user_db. Manual commit AFTER durable Postgres write is
# the only correct semantic.
KAFKA_ENABLE_AUTO_COMMIT=false

# Where to start consuming when no committed offset exists for the group.
# Allowed values: earliest | latest | none.
# `earliest` ensures a freshly deployed User Service picks up any
# in-flight `user.registered` events that were produced while it was
# down — required for crash recovery semantics.
KAFKA_AUTO_OFFSET_RESET=earliest

# Time (ms) the broker waits for a heartbeat before declaring the
# consumer dead and triggering a rebalance.
KAFKA_SESSION_TIMEOUT_MS=30000

# Heartbeat interval (ms) the consumer sends to the group coordinator.
# Must be significantly less than KAFKA_SESSION_TIMEOUT_MS — typically
# one third of it — to avoid spurious rebalances under transient
# network blips.
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# Maximum interval (ms) between successive `poll()` calls before the
# consumer is removed from the group. Bounds worst-case message
# processing time. Set generously to absorb DB hiccups during a
# `user.registered` insert; AAP R-17 retry kicks in for true failures.
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Minimum bytes the broker will wait to accumulate before responding to
# a fetch request. 1 KiB minimizes per-message latency for low-volume
# topics like `user.registered`.
KAFKA_FETCH_MIN_BYTES=1024

# Maximum bytes the broker will return in a single fetch response.
# 10 MiB comfortably contains a full batch of `user.registered` events
# while bounding consumer memory usage during catch-up after an outage.
KAFKA_FETCH_MAX_BYTES=10485760

# Maximum records returned in a single `poll()` — bounds peak memory
# and the blast radius of a poison message before the consumer
# rebalances away from a problem partition.
KAFKA_MAX_POLL_RECORDS=100

# Backoff (ms) between consumer-side retries on transient broker
# errors. Combined with consumer-side jitter applied by librdkafka.
KAFKA_CONSUMER_RETRY_BACKOFF_MS=200


# =============================================================================
# Group E: Kafka Topics & DLQ — AAP R-17, R-30
# =============================================================================
# Topic names mirror the AAP Section 0.4.2 integration matrix verbatim —
# DO NOT rename without an event-catalog update across the monorepo.
# Per AAP R-30, topic names equal event names (<domain>.<verb>).
# Suffixes are appended to a base topic to form the retry / DLQ partner
# topics, e.g. `user.registered` -> `user.registered.retry` ->
# `user.registered.dlq`.

# Consumed (from Auth Service per AAP Section 0.4.2). Emitted by Auth
# Service on every successful OAuth registration; this service handles
# it by creating the corresponding row in `users`.
KAFKA_TOPIC_USER_REGISTERED=user.registered

# Produced (per AAP Section 0.4.2; topic name == event name per AAP R-30).
# Emitted by this service on every successful profile / preference /
# address update. Consumed by Notification Service (welcome / change
# notifications) and Recommendation Engine (user-feature refresh).
KAFKA_TOPIC_USER_UPDATED=user.updated

# Produced (per AAP Section 0.4.2). Emitted by this service on user
# soft-delete or hard-delete. Consumed by every service that holds
# user-derived denormalizations (Notification user_channel_prefs,
# Recommendation feature store, etc.) for downstream cleanup.
KAFKA_TOPIC_USER_DELETED=user.deleted

# Suffix appended to a base topic to form its retry topic per AAP R-17.
# Failed messages are republished here with backoff metadata before
# final DLQ routing.
KAFKA_RETRY_TOPIC_SUFFIX=.retry

# Suffix appended to a base topic to form its dead-letter topic per
# AAP R-17. Messages exhausting all retries are persisted here for
# human triage.
KAFKA_DLQ_TOPIC_SUFFIX=.dlq

# Maximum in-process retry attempts for a single consumed message
# before it is routed to the retry topic. Aligns with AAP R-15 (bounded
# retry count) and AAP R-17 (DLQ routing on retry exhaustion).
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=5

# Initial backoff (seconds) between in-process retries for the consumer.
# Multiplied with KAFKA_CONSUMER_RETRY_MULTIPLIER and randomized by
# KAFKA_CONSUMER_RETRY_JITTER_FRACTION on each subsequent attempt
# (exponential backoff per AAP R-15).
KAFKA_CONSUMER_RETRY_INITIAL_DELAY_SECONDS=2

# Cap (seconds) on the per-attempt backoff so the consumer never
# sleeps for an unbounded duration even if the multiplier compounds
# over many retries.
KAFKA_CONSUMER_RETRY_MAX_DELAY_SECONDS=60

# Multiplier applied to the consumer-side backoff after every failed
# attempt (exponential backoff per AAP R-15). 2.0 doubles the sleep
# each round (2s -> 4s -> 8s -> ... capped at 60s).
KAFKA_CONSUMER_RETRY_MULTIPLIER=2.0

# Jitter fraction added to each backoff value (uniform random in
# `[-jitter, +jitter]` * delay) to avoid thundering-herd retries
# across consumer replicas (AAP R-15). 0.2 means +/-20% of the
# computed backoff.
KAFKA_CONSUMER_RETRY_JITTER_FRACTION=0.2


# =============================================================================
# Group F: Schema Registry — AAP R-14
# =============================================================================
# Confluent Schema Registry validates every event payload (AAP R-14)
# and enforces backward-compatible schema evolution (AAP R-31, R-33).
# Schemas are managed centrally under `infrastructure/kafka/schemas/`
# and registered out-of-band — the service does NOT auto-register on
# startup (auto-register would let a buggy producer silently introduce
# an incompatible schema version).

# Schema Registry HTTP URL. Default points at the local Compose
# Schema Registry; override per environment via Vault / K8s ConfigMap.
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Optional Schema Registry HTTP Basic Auth username. Empty in this
# template; populated via K8s Secret when the Schema Registry
# deployment requires authentication.
SCHEMA_REGISTRY_AUTH_USER=

# Optional Schema Registry HTTP Basic Auth password. Empty in this
# template; populated via K8s Secret.
SCHEMA_REGISTRY_AUTH_PASS=

# HTTP request timeout (seconds) for Schema Registry calls. Tight
# enough to fail fast against an unreachable registry without
# flapping the producer's retry loop on transient packet loss.
SCHEMA_REGISTRY_REQUEST_TIMEOUT_SECONDS=10

# Subject name (per Confluent's `<topic>-value` convention) used to
# look up the schema for `user.registered` events.
SCHEMA_REGISTRY_SUBJECT_USER_REGISTERED=user.registered-value

# Subject name used to look up the schema for `user.updated` events.
SCHEMA_REGISTRY_SUBJECT_USER_UPDATED=user.updated-value

# Subject name used to look up the schema for `user.deleted` events.
SCHEMA_REGISTRY_SUBJECT_USER_DELETED=user.deleted-value

# Whether the producer is permitted to auto-register a new schema
# version with the Schema Registry on its first publish. MUST remain
# `false` in every environment — schemas are managed via
# `infrastructure/kafka/schemas/` and registered by a dedicated CI
# workflow so a buggy producer cannot silently degrade the contract.
SCHEMA_REGISTRY_AUTO_REGISTER_SCHEMAS=false


# =============================================================================
# Group G: Authentication / JWT Validation — AAP R-21, R-22, R-23
# =============================================================================
# The User Service VALIDATES JWTs minted by the Auth Service. It is
# NEVER an issuer (per AAP R-21 — Auth Service is the SOLE issuer of
# JWT tokens). Public keys are fetched from the Auth Service JWKS
# endpoint and cached with a bounded TTL (per AAP R-22) so rotation
# propagates without service restart. Per-endpoint scope requirements
# (below) enforce least-privilege access.

# Base URL of the Auth Service. Default points at the local Compose
# Auth Service; override per environment via Vault / K8s ConfigMap.
AUTH_SERVICE_URL=http://auth-service:8000

# Full URL of the JWKS endpoint exposed by the Auth Service. The
# service fetches and caches the JWK set on startup and refreshes
# it according to JWKS_CACHE_TTL_SECONDS.
JWT_PUBLIC_KEY_URL=http://auth-service:8000/.well-known/jwks.json

# Expected `iss` (issuer) claim on every accepted JWT. Placeholder
# default; override per environment with the canonical Auth Service
# issuer URL. Tokens with a mismatched `iss` are rejected with
# `401 Unauthorized`.
JWT_ISSUER=https://auth.example.com

# Expected `aud` (audience) claim on every accepted JWT. The Auth
# Service mints tokens with `aud=user-service` for any caller
# attempting to invoke this service's API. Tokens addressed to a
# different audience are rejected even if the signature validates.
JWT_AUDIENCE=user-service

# Comma-separated list of allowed signature algorithms. Asymmetric
# algorithms only (per AAP R-23: OAuth 2.0 with public-key
# signatures); symmetric algorithms (HS256/384/512) are FORBIDDEN
# here because they would imply this service shares a signing
# secret with the Auth Service — a violation of R-21.
JWT_ALLOWED_ALGORITHMS=RS256,EdDSA

# Allowed clock-skew tolerance (seconds) when validating `exp` and
# `nbf` claims. Bounded to defeat trivial replay-after-expiry attacks
# while absorbing routine clock drift between hosts.
JWT_LEEWAY_SECONDS=30

# Bounded TTL (seconds) for cached JWKS responses (AAP R-22).
# Aggressive caching reduces auth-service load; bounded TTL ensures
# key rotation propagates without service restart.
JWKS_CACHE_TTL_SECONDS=600

# Maximum number of distinct JWK signing keys retained in the cache.
# Sized to comfortably hold the active key plus a few prior versions
# during a rotation window without unbounded memory growth.
JWKS_CACHE_MAX_KEYS=16

# Comma-separated OAuth scopes that authorize a caller to read user
# data. `users:read` permits admin reads; `users:self` permits a
# caller to read their own user record (the API Gateway / Auth
# Service issues `users:self` to every authenticated user).
JWT_REQUIRED_SCOPES_USER_READ=users:read,users:self

# Comma-separated OAuth scopes that authorize a caller to write user
# data. `users:write` permits admin writes; `users:self` permits a
# caller to update their own profile / preferences / addresses.
JWT_REQUIRED_SCOPES_USER_WRITE=users:write,users:self

# OAuth scope that authorizes administrative operations across all
# users (list users, force-delete, audit). Distinct from
# `users:write` to enable least-privilege separation between regular
# users and platform operators.
JWT_REQUIRED_SCOPES_USER_ADMIN=users:admin


# =============================================================================
# Group H: User Domain Configuration — Service-Specific
# =============================================================================
# Domain-specific knobs governing how the User Service handles profile
# storage, soft-delete, opt-in defaults, and validation limits. These
# values shape the behavior of `/users/me`, the addresses sub-resource,
# and the preferences sub-resource. Defaults are tuned for a typical
# global storefront and can be overridden per environment without code
# changes.

# Master switch for soft-delete on `DELETE /users/me`. When `true`,
# the row is retained with `deleted_at` set and PII fields are
# anonymized in place; when `false`, the row is hard-deleted. Soft-
# delete is the default to support GDPR right-to-erasure auditability
# without losing referential integrity in `orders`/`payments`/etc.
USER_SOFT_DELETE_ENABLED=true

# Cryptographic salt used to derive hash-stable PII placeholders on
# soft-delete (e.g., the email field becomes `deleted-<hex>@example`
# where `<hex>` is HMAC(salt, original_email)). The salt's secrecy is
# REQUIRED for lookup-resistant anonymization — without secret salt,
# an attacker who later obtains the soft-deleted rows could re-identify
# users by hashing candidate emails. Empty in this template; populated
# via K8s Secret / Vault per AAP R-25.
USER_PII_ANONYMIZATION_HASH_SALT=

# Default locale assigned to a new user when the registration event
# does not supply one. IETF BCP 47 tag (e.g., en-US, fr-FR, hi-IN).
# Used by Notification Service to render templates in the user's
# language.
USER_DEFAULT_LOCALE=en-US

# Default ISO 4217 currency code assigned to a new user. Used by
# Order Service to default the currency on new orders and by Payment
# Service to route to Stripe vs Razorpay per AAP R-10 (data-driven
# provider selection).
USER_DEFAULT_CURRENCY=USD

# Default IANA timezone assigned to a new user. Used by Notification
# Service to render localized timestamps in templates and by the
# admin UI to render user activity timelines in the user's local time.
USER_DEFAULT_TIMEZONE=UTC

# Default email opt-in state for new users. `true` matches AAP R-11
# (Notification Service routes per user_channel_prefs) — operators may
# flip to `false` to require explicit opt-in for compliance regimes
# (e.g., EU GDPR strict consent).
USER_DEFAULT_EMAIL_OPT_IN=true

# Default SMS opt-in state for new users. `false` is the conservative
# default because SMS carries higher per-message cost than email and
# regulatory regimes (TCPA in the US, PECR in the UK, India DLT) often
# require explicit consent.
USER_DEFAULT_SMS_OPT_IN=false

# Default marketing opt-in state for new users. `false` is the
# conservative default — marketing communications typically require
# explicit affirmative consent independent of transactional
# notifications.
USER_DEFAULT_MARKETING_OPT_IN=false

# Maximum number of `user_addresses` rows a single user may persist.
# Defends against runaway address-book bloat from misbehaving clients
# while comfortably exceeding the 5-10 addresses a typical user
# accumulates over an account lifetime.
USER_MAX_ADDRESSES_PER_USER=20

# Maximum length (UTF-8 characters) of the user's phone number field.
# 32 comfortably accommodates the longest valid E.164 number (15
# digits) plus formatting characters (`+`, spaces, parentheses) for
# locale-specific display formats.
USER_MAX_PHONE_LENGTH=32

# Maximum length (UTF-8 characters) of the user's display name. 120
# accommodates the longest typical names (multi-component family
# names, transliterations) without permitting abuse vectors (XSS via
# overly long names, log-pollution attacks).
USER_MAX_DISPLAY_NAME_LENGTH=120

# Maximum length (bytes) of the user's avatar URL. 2048 matches the
# de facto URL length cap (RFC 7230 recommends servers handle 8000+
# but most CDNs / proxies enforce 2-4 KiB caps).
USER_MAX_AVATAR_URL_LENGTH=2048

# Comma-separated allowlist of HTTPS hosts permitted as avatar URLs
# (e.g., `cdn.example.com,gravatar.com`). Empty value permits any
# HTTPS host — operators tighten this in higher environments to
# defend against SSRF and to ensure avatars only load from trusted
# CDNs.
USER_ALLOWED_AVATAR_HOSTS=

# Default ISO 3166-1 alpha-2 country code passed to libphonenumber
# when validating phone numbers without an explicit country prefix.
# Override per regional deployment (e.g., `IN` for India-only
# storefronts, `GB` for UK).
USER_PHONE_VALIDATION_REGION=US

# Minimum age (years) accepted for `date_of_birth` on profile creation
# / update. 13 is the COPPA / GDPR child-protection floor (see
# 16 CFR Part 312 in the US and Article 8 GDPR in the EU). Operators
# in stricter jurisdictions raise this to 16 or 18.
USER_DATE_OF_BIRTH_MIN_AGE_YEARS=13

# Maximum age (years) accepted for `date_of_birth`. 130 defends against
# obviously-bogus dates (year 1500, year 0) without rejecting any
# plausibly living human.
USER_DATE_OF_BIRTH_MAX_AGE_YEARS=130

# Per-user rate limit (requests / minute) on `PATCH /users/me`. Rate
# limit is keyed on user_id — defends against runaway clients spamming
# profile updates that would amplify into the `user.updated` topic.
USER_PROFILE_UPDATE_RATE_LIMIT_PER_MINUTE=20

# Per-user rate limit (requests / minute) on preferences update
# endpoints. Same rationale as profile updates — bounds amplification
# into `user.updated` events.
USER_PREFERENCES_UPDATE_RATE_LIMIT_PER_MINUTE=20

# Per-user rate limit (requests / minute) on address create / update /
# delete endpoints. Each address mutation also emits `user.updated`
# (preferences for shipping-address-derived fields).
USER_ADDRESSES_UPDATE_RATE_LIMIT_PER_MINUTE=20


# =============================================================================
# Group I: Outbox / Event Publishing — Recommended Pattern
# =============================================================================
# The User Service implements the transactional outbox pattern: every
# `user.updated` / `user.deleted` event is first written to an `outbox`
# table within the same database transaction as the domain change, then
# a background dispatcher claims rows in batches and publishes them to
# Kafka. This guarantees that a successful HTTP write durably enqueues
# its event without a distributed transaction — a necessary correctness
# guarantee given idempotent producer + manual consumer commits in the
# rest of the platform.

# Polling interval (ms) for the outbox dispatcher loop. 500 ms balances
# end-to-end event latency against database load — short enough to keep
# downstream consumers near-real-time, long enough to amortize the
# `SELECT ... FOR UPDATE SKIP LOCKED` claim query.
OUTBOX_DISPATCH_INTERVAL_MS=500

# Maximum outbox rows claimed and published in a single dispatcher
# iteration. Keeps memory bounded under burst load while exploiting
# Kafka's batch-publish efficiency.
OUTBOX_DISPATCH_BATCH_SIZE=100

# Maximum total Kafka publish attempts for a single outbox row before
# it is marked failed and routed to the DLQ. Aligns with AAP R-15
# (bounded retry attempts).
OUTBOX_DISPATCH_MAX_RETRIES=10

# Retention window (days) for successfully dispatched outbox rows
# before they are purged by the cleanup job. 14 days gives ops a
# comfortable forensic window without bloating the outbox table.
OUTBOX_RETENTION_DAYS=14

# Retention window (days) for failed / DLQed outbox rows. Longer than
# the success retention so forensic analysis can reconstruct the
# failure scenario weeks later.
OUTBOX_FAILED_RETENTION_DAYS=90


# =============================================================================
# Group J: HTTP Client (Outbound) — AAP R-15, R-16
# =============================================================================
# Default values applied to every outbound HTTP call this service makes.
# Outbound HTTP traffic is intentionally minimal — primarily JWKS
# fetches from the Auth Service for JWT validation (Group G). The
# variables in this group keep retry / circuit-breaker behavior
# consistent with the sibling services so operators learn ONE
# resilience playbook for the whole monorepo.

# Default response read timeout (seconds) for outbound HTTP calls
# without a more specific override. Bounds the overall call latency
# for JWKS fetches and any future external integrations.
HTTP_CLIENT_DEFAULT_TIMEOUT_SECONDS=10

# TCP / TLS handshake timeout (seconds) for outbound HTTP calls
# without a more specific override. Tight enough to fail fast against
# an unreachable host without flapping the circuit breaker on
# transient packet loss.
HTTP_CLIENT_CONNECT_TIMEOUT_SECONDS=3

# Maximum number of attempts (initial + retries) per AAP R-15. After
# this is exhausted the call surfaces an error to the caller and the
# circuit-breaker counters tick toward OPEN.
HTTP_CLIENT_RETRY_MAX_ATTEMPTS=3

# Initial backoff (ms) before the first retry. Combined with
# HTTP_CLIENT_RETRY_MULTIPLIER and HTTP_CLIENT_RETRY_JITTER_FRACTION
# to compute the effective sleep on each attempt per AAP R-15.
HTTP_CLIENT_RETRY_INITIAL_DELAY_MS=200

# Multiplier applied to the backoff after every failed attempt
# (exponential backoff per AAP R-15). 2.0 doubles the sleep each
# round (200 ms -> 400 ms -> 800 ms -> ...).
HTTP_CLIENT_RETRY_MULTIPLIER=2.0

# Cap (ms) on the per-attempt backoff so the worker never sleeps for
# an unbounded duration even if the multiplier compounds over many
# retries.
HTTP_CLIENT_RETRY_MAX_DELAY_MS=5000

# Jitter fraction added to each backoff value (uniform random in
# `[-jitter, +jitter]` * delay) to avoid thundering-herd retries
# across many workers (AAP R-15). 0.2 means +/-20% of the computed
# backoff.
HTTP_CLIENT_RETRY_JITTER_FRACTION=0.2

# Number of failures within the rolling window required to trip the
# circuit breaker into the OPEN state per AAP R-16.
HTTP_CLIENT_CB_FAILURE_THRESHOLD=10

# Failure-rate threshold (0.0 – 1.0) at which the circuit breaker
# transitions from CLOSED to OPEN per AAP R-16. 0.5 means open after
# 50% of recent calls have failed.
HTTP_CLIENT_CB_FAILURE_RATE=0.5

# Duration (seconds) the circuit breaker remains OPEN before
# transitioning to HALF_OPEN to probe the upstream provider per
# AAP R-16.
HTTP_CLIENT_CB_OPEN_DURATION_SECONDS=30

# Number of probe calls permitted while the circuit breaker is in
# the HALF_OPEN state before deciding CLOSED vs OPEN per AAP R-16.
HTTP_CLIENT_CB_HALF_OPEN_PROBES=1

# `User-Agent` header sent on every outbound HTTP request. Aids
# upstream providers in identifying our traffic during incident
# triage and rate-limit allocation.
HTTP_CLIENT_USER_AGENT=user-service/1.0


# =============================================================================
# Group K: Health Probes — AAP R-19
# =============================================================================
# Liveness and readiness probes consumed by Kubernetes (or the local
# Compose health check). Liveness checks confirm the process is alive;
# readiness checks confirm the process is able to serve traffic
# (database reachable, Kafka producer initialized, Kafka consumer
# joined, Schema Registry resolvable, JWKS primed). Per AAP R-19,
# missing critical dependencies at startup MUST cause the service to
# fail fast and never report ready.

# HTTP path served by the liveness probe (AAP R-19). Returns
# `200 OK` when the process is running and the event loop is
# responsive. The Kubernetes kubelet calls this endpoint and
# restarts the pod on repeated failure.
HEALTH_LIVE_PATH=/health/live

# HTTP path served by the readiness probe (AAP R-19). Returns
# `200 OK` only after every dependency listed in
# HEALTH_READY_DEPENDENCIES has reported healthy. Returns
# `503 Service Unavailable` during startup or when a critical
# dependency is degraded — kubelet will withhold traffic from this
# pod until ready.
HEALTH_READY_PATH=/health/ready

# Comma-separated list of dependency identifiers checked by the
# readiness probe. Each name maps to a registered health-check
# function in `src/health/`.
HEALTH_READY_DEPENDENCIES=postgres,kafka_producer,kafka_consumer,schema_registry

# Whether to fail fast on missing critical dependencies at startup
# (AAP R-19). When `true`, the service exits with a non-zero status
# rather than starting in a degraded state — Kubernetes will then
# surface the failure immediately via pod CrashLoopBackOff rather
# than reporting healthy and silently dropping traffic.
HEALTH_READY_FAIL_FAST_ON_STARTUP=true


# =============================================================================
# Group L: Observability — AAP R-13, R-26, R-27
# =============================================================================
# All structured JSON logs (AAP R-26) ship via Filebeat to Logstash
# (AAP R-27). Metrics expose on `/metrics` for Prometheus / Metricbeat
# scraping. OpenTelemetry traces are optional locally but mandatory in
# non-local environments. The correlation ID generated at the API
# Gateway is propagated through every HTTP call and Kafka message
# header (AAP R-13) for distributed tracing.

# Logical service name attached to every emitted span. Must match
# SERVICE_NAME for cross-correlation between logs and traces in
# Kibana.
OTEL_SERVICE_NAME=user-service

# Resource attributes attached to every emitted telemetry signal.
# Comma-separated `key=value` pairs in W3C Resource format.
# `${ENVIRONMENT}` is interpolated at runtime by the pydantic-settings
# loader so the deployment environment label propagates into traces
# and metrics without a separate variable.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=ecommerce,service.version=0.1.0,deployment.environment=${ENVIRONMENT}

# OpenTelemetry collector OTLP endpoint, e.g. http://otel-collector:4317.
# Optional in local development; populated per environment when an
# OTLP collector is present in the cluster.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP transport protocol. Allowed values: grpc | http/protobuf.
# `grpc` is the default for high-throughput trace export.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# OpenTelemetry traces exporter. `otlp` ships traces over the OTLP
# protocol to the collector configured in OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_TRACES_EXPORTER=otlp

# OpenTelemetry metrics exporter. `otlp` ships metrics over the OTLP
# protocol; Prometheus is also exposed on /metrics for direct scrape.
OTEL_METRICS_EXPORTER=otlp

# Sampling strategy for OpenTelemetry traces. `parentbased_traceidratio`
# inherits the parent decision (e.g., from the API Gateway) and falls
# back to a fixed ratio for root spans. Allowed values follow the
# OpenTelemetry SDK sampler specification.
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampling ratio (0.0 – 1.0) applied to root spans by the
# `traceidratio` portion of the sampler. 10% sampling balances
# observability cost vs coverage.
OTEL_TRACES_SAMPLER_ARG=0.1

# URL path served by the Prometheus metrics endpoint. Standard
# `/metrics` per Prometheus conventions; override only when a reverse
# proxy mounts the metrics under a non-standard prefix.
PROMETHEUS_METRICS_PATH=/metrics

# HTTP port exposing the Prometheus metrics endpoint. Empty (default)
# means metrics are served on the same port as HTTP_PORT — operators
# wishing to isolate scraping traffic on a separate network policy
# should set this to a distinct port (e.g., 9090) and update the
# Dockerfile EXPOSE / Kubernetes Service ports accordingly.
PROMETHEUS_METRICS_PORT=

# Inbound / outbound HTTP header name used to propagate the request
# correlation ID across HTTP calls per AAP R-13. The API Gateway
# injects this header on every inbound request; this service
# preserves it on every log line and outbound call.
CORRELATION_ID_HEADER=X-Correlation-ID

# Kafka message header name used to propagate the correlation ID
# across asynchronous boundaries per AAP R-13. Producers set this
# header on every emitted record; consumers read it and bind it to
# the per-message log context.
CORRELATION_ID_KAFKA_HEADER=correlation_id


# =============================================================================
# Group M: Feature Flags
# =============================================================================
# Operator-flippable switches. Stable features default to `true`;
# experimental or compliance-sensitive features default to `false` so
# they are explicitly enabled per environment after validation.

# Master switch for the transactional outbox dispatcher (Group I).
# When `false`, `user.updated` / `user.deleted` events are written to
# the outbox table but never published — useful for maintenance windows
# during which downstream consumers must be paused. Re-enabling drains
# the backlog automatically.
FEATURE_OUTBOX_ENABLED=true

# Master switch for the admin API surface (`/admin/users`,
# `/admin/users/{id}`). Disable in environments where only end-user
# self-service endpoints should be exposed (e.g., a hardened
# customer-facing edge with no operator access).
FEATURE_ADMIN_API_ENABLED=true

# Master switch for PII anonymization on soft-delete (Group H). When
# `true`, soft-delete replaces email / phone / display_name with
# hash-stable placeholders; when `false`, the original PII is
# preserved alongside `deleted_at` (use only when legal / compliance
# explicitly authorizes preserving deleted-user PII for an audit
# window).
FEATURE_PII_ANONYMIZATION_ON_SOFT_DELETE=true

# Master switch for locale auto-detection from the request
# `Accept-Language` header on profile creation. When `true` and no
# locale is supplied, the Auth Service registration handler infers
# the user's preferred locale from the request's Accept-Language;
# when `false`, USER_DEFAULT_LOCALE is always used. Off by default
# because Accept-Language is easily spoofed — operators should opt
# in only after evaluating their locale-quality requirements.
FEATURE_LOCALE_AUTODETECT=false


# =============================================================================
# Group N: Migrations
# =============================================================================
# Database schema migrations are managed by Alembic and live under
# `services/user-service/migrations/`. The migration table name is
# distinct per service so multiple services sharing a Postgres
# cluster (in development) do not collide on `alembic_version`.

# Whether to run `alembic upgrade head` automatically before the HTTP
# server starts. Convenient for local development and small
# deployments; in production set to `false` and run migrations from
# a dedicated init container or one-shot Job to avoid races between
# multiple replicas attempting to migrate concurrently.
RUN_MIGRATIONS_ON_STARTUP=true

# Filesystem path (relative to the service root) where Alembic
# migration scripts live. Must match the `script_location` setting
# in `alembic.ini`.
MIGRATIONS_DIR=migrations

# Alembic version table name. Distinct per service so this service's
# migration history does not collide with sibling services'
# histories when sharing a Postgres cluster.
MIGRATIONS_TABLE=alembic_version_user_service


# =============================================================================
# IMPORTANT (User Service is both producer and consumer):
#   * Required at startup (service MUST fail fast per AAP R-19 if any
#     of these are missing or unreachable):
#       - POSTGRES_URL          (private user_db)
#       - KAFKA_BOOTSTRAP_SERVERS (event backbone)
#       - SCHEMA_REGISTRY_URL   (event schema validation)
#       - AUTH_SERVICE_URL      (JWT validation)
#       - JWT_PUBLIC_KEY_URL    (JWKS endpoint)
#       - JWT_ISSUER            (expected `iss` claim)
#
#   * NEVER commit real values for POSTGRES_URL, KAFKA_SASL_PASSWORD,
#     SCHEMA_REGISTRY_AUTH_PASS, USER_PII_ANONYMIZATION_HASH_SALT, or
#     any *_URL pointing at a production endpoint (AAP R-25).
#
#   * KAFKA_ENABLE_AUTO_COMMIT MUST remain `false` — the consumer
#     commits offsets only AFTER the corresponding Postgres write has
#     durably persisted. Auto-commit would silently lose state
#     transitions across crashes.
#
#   * KAFKA_PRODUCER_ENABLE_IDEMPOTENCE MUST remain `true` AND
#     KAFKA_PRODUCER_ACKS MUST remain `all` — `user.updated` /
#     `user.deleted` events must not be silently lost during broker
#     failover, and the outbox dispatcher (Group I) relies on safe
#     retry semantics for at-least-once delivery.
#
#   * SCHEMA_REGISTRY_AUTO_REGISTER_SCHEMAS MUST remain `false` —
#     schemas are managed via `infrastructure/kafka/schemas/` and
#     registered by a dedicated CI workflow.
#
#   * The User Service does NOT need Stripe / Razorpay / Twilio /
#     SendGrid credentials — those belong to Payment / Notification
#     services. Do NOT add provider-specific keys here.
#
#   * The User Service does NOT need Redis or pgvector — those are
#     specific to the Recommendation Engine.
#
#   * JWT keys are fetched at runtime from JWT_PUBLIC_KEY_URL; no
#     static signing secret is required here (this service only
#     VALIDATES JWTs, never issues them — AAP R-21).
#
#   * In Kubernetes, these values come from a ConfigMap (non-secret)
#     plus a Secret (credentials) pair; rotate via the runbook
#     documented in `docs/runbook/user-service.md`.
# =============================================================================
